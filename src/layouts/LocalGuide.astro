---
import Layout from './Layout.astro';
import { businessFacts, getWinterNotice } from '../lib/business-facts';
interface Section { heading: string; paragraphs: readonly string[]; source?: { title: string; url: string }; }
interface Props { title: string; description: string; intro: string; sections: readonly Section[]; related: readonly { title: string; url: string }[]; lang?: 'es' | 'en'; dateModified: string; datePublished?: string; }
const { title, description, intro, sections, related, lang = 'es', dateModified, datePublished = '2026-10-12' } = Astro.props;
const en = lang === 'en';
const address = businessFacts.confirmed.address!;
const map = 'https://www.google.com/maps?cid=13237319999262880412';
const hub = en ? '/en/guide/' : '/guia/';
const contact = en ? '/en/contact' : '/contacto';
---
<Layout title={title} description={description} lang={lang} hasLocationFAQ breadcrumbs={[{name: en ? 'Guides' : 'Guías', url: `https://dirtyrabbit.es${hub}`}, {name: title, url: `https://dirtyrabbit.es${Astro.url.pathname}`}]} articleMeta={{ datePublished, dateModified, section: en ? 'Local guide' : 'Guía local' }}>
  <article class="bg-cream">
    <header class="mz-wrap mz-page-head">
      <div class="mz-crumb"><a href={hub}>← {en ? 'Local guides' : 'Guías locales'}</a><span>{en ? 'Sources checked: 12 October 2026.' : 'Fuentes revisadas: 12 de octubre de 2026.'}</span></div>
      <h1 class="font-typewriter mz-page-title">{title}</h1>
      <p class="mz-page-dek">{intro}</p>
    </header>
    <div class="mz-wrap mz-article">
      <aside class="mz-aside">
        <section class="mz-box" data-our-cafe>
          <h2>Dirty Rabbit — {en ? 'our café in S’Agaró' : 'nuestro café en S’Agaró'}</h2>
          <p>{en ? 'Coffee, breakfast and brunch at' : 'Café, desayuno y brunch en'} {address.streetAddress}, {address.postalCode} {address.addressLocality}.</p>
          <p>{en ? 'Plan this as a separate stop in S’Agaró. Check the current journey time on the map, and confirm kitchen service before travelling. Parking spaces and rates depend on the street and date; check the signs when you arrive.' : 'Planifica esta parada en S’Agaró como un desplazamiento aparte. Mira el tiempo de trayecto actual en el mapa y confirma el servicio de cocina antes de salir. Las plazas y tarifas de aparcamiento dependen de la calle y la fecha; consulta la señalización al llegar.'}</p>
          <p>{getWinterNotice(lang)}</p>
          <a href={map} class="mz-btn mz-btn--solid">{en ? 'Map and directions' : 'Mapa y cómo llegar'}</a>
          <p style="margin-top:12px"><a href={en ? '/en/brunch' : '/brunch'}>{en ? 'Breakfast and brunch' : 'Desayuno y brunch'}</a> · <a href={contact}>{en ? 'Contact and hours' : 'Contacto y horarios'}</a></p>
        </section>
      </aside>
      <div class="mz-article-body">
        {sections.map(section => <section data-local-section data-seasonal-status={section.paragraphs.some(p => p.includes('Fitzroy')) ? 'fitzroy' : undefined}>
          <h2>{section.heading}</h2>
          {section.paragraphs.map(text => <p>{text}</p>)}
          {section.source && <p style="font-size:15px"><a href={section.source.url}>{section.source.title}</a></p>}
        </section>)}
        <section data-location-faq>
          <h2>{en ? 'Where is Dirty Rabbit?' : '¿Dónde está Dirty Rabbit?'}</h2>
          <p>{en ? 'We have one café, in S’Agaró. There are no Dirty Rabbit branches in Begur, Girona, Platja d’Aro or the other towns in these guides.' : 'Tenemos un único café, en S’Agaró. No hay locales de Dirty Rabbit en Begur, Girona, Platja d’Aro ni en las otras localidades de estas guías.'}</p>
          <p><a href={en ? '/en/brand-facts' : '/brand-facts'}>{en ? 'Our café facts' : 'Datos de nuestro café'}</a></p>
        </section>
          <nav class="mz-box mz-related" aria-label={en ? 'Related guides' : 'Guías relacionadas'}>
          <h2>{en ? 'Continue planning' : 'Sigue preparando tu visita'}</h2>
          <ul>{related.map(link => <li><a href={link.url}>{link.title}</a></li>)}</ul>
        </nav>
      </div>
    </div>
  </article>
</Layout>
