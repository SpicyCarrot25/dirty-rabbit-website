---
import Layout from './Layout.astro';
import { businessFacts, getWinterNotice } from '../lib/business-facts';
interface Section { heading: string; paragraphs: readonly string[]; source?: { title: string; url: string }; }
interface Props { title: string; description: string; intro: string; sections: readonly Section[]; related: readonly { title: string; url: string }[]; lang?: 'es' | 'en'; dateModified: string; datePublished?: string; }
const { title, description, intro, sections, related, lang = 'es', dateModified, datePublished = '2026-10-12' } = Astro.props;
const en = lang === 'en';
const address = businessFacts.confirmed.address!;
const map = 'https://www.google.com/maps?cid=13237319999262880412';
const hub = en ? '/en/guide/' : '/guia/';
const contact = en ? '/en/contact' : '/contacto';
---
<Layout title={title} description={description} lang={lang} hasLocationFAQ breadcrumbs={[{name: en ? 'Guides' : 'Guías', url: `https://dirtyrabbit.es${hub}`}, {name: title, url: `https://dirtyrabbit.es${Astro.url.pathname}`}]} articleMeta={{ datePublished, dateModified, section: en ? 'Local guide' : 'Guía local' }}>
  <article class="bg-cream py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6 font-mono leading-relaxed">
      <header class="mb-10">
        <a href={hub} class="text-red underline">{en ? 'Local guides' : 'Guías locales'}</a>
        <h1 class="font-typewriter text-4xl md:text-5xl my-6">{title}</h1>
        <p class="text-lg">{intro}</p>
        <p class="text-sm mt-4">{en ? 'Sources checked: 12 October 2026.' : 'Fuentes revisadas: 12 de octubre de 2026.'}</p>
      </header>
      <section class="bg-white p-6 rounded-xl border-l-4 border-red mb-10" data-our-cafe>
        <h2 class="font-typewriter text-2xl mb-3">Dirty Rabbit — {en ? 'our café in S’Agaró' : 'nuestro café en S’Agaró'}</h2>
        <p>{en ? 'Coffee, breakfast and brunch at' : 'Café, desayuno y brunch en'} {address.streetAddress}, {address.postalCode} {address.addressLocality}.</p>
        <p class="mt-3">{en ? 'Plan this as a separate stop in S’Agaró. Check the current journey time on the map, and confirm kitchen service before travelling. Parking spaces and rates depend on the street and date; check the signs when you arrive.' : 'Planifica esta parada en S’Agaró como un desplazamiento aparte. Mira el tiempo de trayecto actual en el mapa y confirma el servicio de cocina antes de salir. Las plazas y tarifas de aparcamiento dependen de la calle y la fecha; consulta la señalización al llegar.'}</p>
        <p class="mt-3">{getWinterNotice(lang)}</p>
        <div class="flex flex-wrap gap-4 mt-5">
          <a href={map} class="bg-red text-white rounded-lg px-4 py-2">{en ? 'Map and directions' : 'Mapa y cómo llegar'}</a>
          <a href={en ? '/en/brunch' : '/brunch'} class="text-red underline">{en ? 'Breakfast and brunch' : 'Desayuno y brunch'}</a>
          <a href={contact} class="text-red underline">{en ? 'Contact and hours' : 'Contacto y horarios'}</a>
        </div>
      </section>
      {sections.map(section => <section class="mb-10" data-local-section data-seasonal-status={section.paragraphs.some(p => p.includes('Fitzroy')) ? 'fitzroy' : undefined}>
        <h2 class="font-typewriter text-2xl md:text-3xl mb-4">{section.heading}</h2>
        {section.paragraphs.map(text => <p class="mb-4">{text}</p>)}
        {section.source && <p class="text-sm"><a class="text-red underline" href={section.source.url}>{section.source.title}</a></p>}
      </section>)}
      <section class="border-t border-black/20 pt-6 mb-8" data-location-faq>
        <h2 class="font-typewriter text-2xl mb-3">{en ? 'Where is Dirty Rabbit?' : '¿Dónde está Dirty Rabbit?'}</h2>
        <p>{en ? 'We have one café, in S’Agaró. There are no Dirty Rabbit branches in Begur, Girona, Platja d’Aro or the other towns in these guides.' : 'Tenemos un único café, en S’Agaró. No hay locales de Dirty Rabbit en Begur, Girona, Platja d’Aro ni en las otras localidades de estas guías.'}</p>
        <p class="mt-3"><a href={en ? '/en/brand-facts' : '/brand-facts'} class="text-red underline">{en ? 'Our café facts' : 'Datos de nuestro café'}</a></p>
      </section>
      <nav aria-label={en ? 'Related guides' : 'Guías relacionadas'}>
        <h2 class="font-typewriter text-2xl mb-3">{en ? 'Continue planning' : 'Sigue preparando tu visita'}</h2>
        <ul class="space-y-3">{related.map(link => <li><a class="text-red underline" href={link.url}>{link.title}</a></li>)}</ul>
      </nav>
    </div>
  </article>
</Layout>
