---
import { getFactCopy, getBusinessSchema, getBusinessField, serializeSchema } from '../lib/business-facts';
import '../styles/global.css';
import '../styles/magazine.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GuideLocationFAQ from '../components/GuideLocationFAQ.astro';
import { getLangFromUrl, getTranslations, getAlternateUrls, type Language } from '../i18n';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface ArticleMeta {
  datePublished: string;
  dateModified?: string;
  author?: string;
  section?: string;
}

interface Props {
  title: string;
  description?: string;
  lang?: Language | 'nl';
  breadcrumbs?: BreadcrumbItem[];
  isMenuPage?: boolean;
  articleMeta?: ArticleMeta;
  hasLocationFAQ?: boolean;
  noindex?: boolean;
}

const { 
  title, 
  description = 'Specialty Coffee, Breakfast & Brunch en S\'Agaró, Costa Brava', 
  lang,
  breadcrumbs,
  isMenuPage = false,
  articleMeta,
  hasLocationFAQ = false,
  noindex = false
} = Astro.props;

const currentLang = lang || getLangFromUrl(Astro.url);
// A Dutch guide uses English site navigation until a Dutch site exists.
const navigationLang = currentLang === 'nl' ? 'en' : currentLang;
const t = getTranslations(navigationLang);
const alternates = getAlternateUrls(Astro.url.pathname, 'https://dirtyrabbit.es');

// Build @graph array with all schema objects
const graphItems: Record<string, unknown>[] = [
  // CafeOrCoffeeShop (LocalBusiness)
  getBusinessSchema("schema-984009e294f3"),
  // WebSite (there is no on-site search endpoint)
  {
    "@type": "WebSite",
    "@id": "https://dirtyrabbit.es/#website",
    "name": "Dirty Rabbit",
    "url": "https://dirtyrabbit.es"
  }
];

// Add BreadcrumbList if provided
if (breadcrumbs && breadcrumbs.length > 0) {
  graphItems.push({
    "@type": "BreadcrumbList",
    "@id": `https://dirtyrabbit.es${Astro.url.pathname}#breadcrumb`,
    "itemListElement": breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": crumb.name,
      "item": crumb.url
    }))
  });
}


if (articleMeta) {
  graphItems.push({
    "@type": "Article",
    "@id": `https://dirtyrabbit.es${Astro.url.pathname}#article`,
    "headline": title,
    "inLanguage": currentLang,
    "description": description,
    "datePublished": articleMeta.datePublished,
    "dateModified": articleMeta.dateModified || articleMeta.datePublished,
    "author": {
      "@type": "Organization",
      "name": articleMeta.author || "Dirty Rabbit",
      "@id": "https://dirtyrabbit.es/#business"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Dirty Rabbit",
      "@id": "https://dirtyrabbit.es/#business"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://dirtyrabbit.es${Astro.url.pathname}`
    },
    "isPartOf": {
      "@id": "https://dirtyrabbit.es/#website"
    },
    ...(articleMeta.section ? { "articleSection": articleMeta.section } : {})
  });
}

// Single unified schema with @graph
const unifiedSchema = {
  "@context": "https://schema.org",
  "@graph": graphItems
};
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/NYCTypewriter-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/NYCTypewriter-Mono.woff2" as="font" type="font/woff2" crossorigin />
    
    <link rel="canonical" href={`https://dirtyrabbit.es${Astro.url.pathname}`} />
    
    {alternates.es && <link rel="alternate" hreflang="es" href={alternates.es} />}
    {alternates.en && <link rel="alternate" hreflang="en" href={alternates.en} />}
    {alternates.ca && <link rel="alternate" hreflang="ca" href={alternates.ca} />}
    {alternates.fr && <link rel="alternate" hreflang="fr" href={alternates.fr} />}
    {alternates.ru && <link rel="alternate" hreflang="ru" href={alternates.ru} />}
    {alternates.uk && <link rel="alternate" hreflang="uk" href={alternates.uk} />}
    {alternates.nl && <link rel="alternate" hreflang="nl" href={alternates.nl} />}
    {alternates.pl && <link rel="alternate" hreflang="pl" href={alternates.pl} />}
    {Object.keys(alternates).length > 0 && <link rel="alternate" hreflang="x-default" href={alternates.es || alternates.en || Object.values(alternates)[0]} />}
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={articleMeta ? "article" : "website"} />
    <meta property="og:url" content={`https://dirtyrabbit.es${Astro.url.pathname}`} />
    <meta property="og:image" content="https://dirtyrabbit.es/og-image.jpg" />
    <meta property="og:locale" content={({ es: 'es_ES', en: 'en_GB', ca: 'ca_ES', fr: 'fr_FR', ru: 'ru_RU', uk: 'uk_UA', pl: 'pl_PL', nl: 'nl_NL' })[currentLang]} />
    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.datePublished} />
        <meta property="article:modified_time" content={articleMeta.dateModified || articleMeta.datePublished} />
      </>
    )}
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <script type="application/ld+json" set:html={JSON.stringify(unifiedSchema)} />
    
    <title>{title}</title>
    
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0RBR92LJQK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0RBR92LJQK');
      
      // Custom event tracking
      document.addEventListener('DOMContentLoaded', function() {
        document.addEventListener('click', function(e) {
          var link = e.target.closest('a');
          if (!link) return;
          var href = link.href || '';
          
          // Order button (Square)
          if (href.includes('order.dirtyrabbit.es')) {
            gtag('event', 'click_order', { event_category: 'cta', event_label: href });
          }
          // Google Maps / directions
          else if (href.includes('maps.google') || href.includes('goo.gl/maps')) {
            gtag('event', 'click_directions', { event_category: 'cta', event_label: 'google_maps' });
          }
          // Phone call
          else if (href.startsWith('tel:')) {
            gtag('event', 'click_call', { event_category: 'cta', event_label: href });
          }
          // Instagram
          else if (href.includes('instagram.com')) {
            gtag('event', 'click_social', { event_category: 'social', event_label: 'instagram' });
          }
          // Spotify
          else if (href.includes('spotify.com')) {
            gtag('event', 'click_social', { event_category: 'social', event_label: 'spotify' });
          }
        });
        
        // Newsletter form submit
        var nlForm = document.querySelector('form[action*="newsletter"], form[data-newsletter]');
        if (nlForm) {
          nlForm.addEventListener('submit', function() {
            gtag('event', 'newsletter_signup', { event_category: 'conversion' });
          });
        }
      });
    </script>
    <!-- Meta Pixel -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1968087450813045');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1968087450813045&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel -->
    <slot name="head" />
  </head>
  <body class="mag min-h-screen flex flex-col">
    <Header lang={navigationLang} />
    <main class="flex-1">
      <slot />
      {!hasLocationFAQ && /\/(guia|guide|guides)\//.test(Astro.url.pathname) && <GuideLocationFAQ lang={navigationLang} />}
    </main>
    <Footer lang={navigationLang} />
  </body>
</html>
