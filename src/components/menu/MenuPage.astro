---
import Layout from '../../layouts/Layout.astro';
import { type Language } from '../../i18n';
import { getMenuPageView, type MenuRenderBlock, type MenuRenderItem } from '../../lib/menu';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const view = getMenuPageView(lang);
---

<Layout
  title={view.page.metaTitle}
  description={view.page.metaDescription}
  lang={lang}
  breadcrumbs={view.breadcrumbs}
  isMenuPage={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(view.schema)} />
  </Fragment>

  <section class="pt-8 pb-12 md:pt-12 md:pb-16 bg-cream">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-typewriter text-5xl md:text-6xl font-bold text-red mb-6">{view.page.title}</h1>
      <div class="w-16 h-px bg-red mx-auto mb-8"></div>
      <p class="font-mono text-sm md:text-base text-black/80 leading-relaxed max-w-xl mx-auto">
        {view.page.introBeforeLink}
        <a href={view.producerPath} class="text-red hover:underline">{view.page.introLinkLabel}</a>
        {view.page.introAfterLink}
      </p>
    </div>
  </section>

  <section class="py-8 md:py-12 bg-cream">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      {view.sections.map((section, index) => (
        <div
          id={section.id}
          class:list={[
            'scroll-mt-20',
            index > 0 && 'mt-16 pt-16 border-t border-red'
          ]}>
          <h2 class="font-typewriter text-5xl md:text-6xl font-bold text-red mb-8 text-center">{section.title}</h2>

          {section.blocks.map((block) => (
            block.type === 'list' ? (
              <>
                <h3 class="font-typewriter text-3xl md:text-4xl font-bold text-red mb-4 mt-8">
                  {block.title}
                  {block.subtitle && <span class="font-mono text-sm font-normal text-black/70"> ({block.subtitle})</span>}
                </h3>

                <div class:list={[block.descriptionStyle === 'stacked' ? 'space-y-5' : 'space-y-4']}>
                  {block.items.map((item) => (
                    <div class:list={[
                      block.descriptionStyle === 'stacked' ? 'flex items-start justify-between gap-4' : 'flex items-baseline justify-between gap-4'
                    ]}>
                      <div class="flex-1 min-w-0">
                        {block.descriptionStyle === 'stacked' ? (
                          <>
                            <div class="flex flex-wrap items-center gap-2">
                              <h4 class="font-typewriter text-lg font-bold">{item.name}</h4>
                              {item.badge && <span class="badge">{item.badge}</span>}
                            </div>
                            {item.desc && <p class="font-mono text-sm text-black/70 mt-1">{item.desc}</p>}
                          </>
                        ) : (
                          <>
                            <span class="font-typewriter text-lg font-bold">{item.name}</span>
                            {block.descriptionStyle === 'inline' && item.desc && <span class="font-mono text-sm text-black/70 ml-2">{item.desc}</span>}
                          </>
                        )}
                      </div>
                      <span class:list={[
                        'font-typewriter text-lg font-bold text-red tabular-nums shrink-0',
                        block.descriptionStyle === 'stacked' && 'mt-0.5'
                      ]}>{item.price}</span>
                    </div>
                  ))}
                </div>

                {block.secondaryTitle && <h4 class="font-mono text-sm uppercase tracking-[0.2em] text-black/70 mt-6 mb-3">{block.secondaryTitle}</h4>}
                {block.secondaryItems && (
                  <div class:list={[block.secondaryDescriptionStyle === 'stacked' ? 'space-y-5' : 'space-y-4']}>
                    {block.secondaryItems.map((item) => (
                      <div class:list={[
                        block.secondaryDescriptionStyle === 'stacked' ? 'flex items-start justify-between gap-4' : 'flex items-baseline justify-between gap-4'
                      ]}>
                        <div class="flex-1 min-w-0">
                          {block.secondaryDescriptionStyle === 'stacked' ? (
                            <>
                              <div class="flex flex-wrap items-center gap-2">
                                <h4 class="font-typewriter text-lg font-bold">{item.name}</h4>
                                {item.badge && <span class="badge">{item.badge}</span>}
                              </div>
                              {item.desc && <p class="font-mono text-sm text-black/70 mt-1">{item.desc}</p>}
                            </>
                          ) : (
                            <>
                              <span class="font-typewriter text-lg font-bold">{item.name}</span>
                              {block.secondaryDescriptionStyle === 'inline' && item.desc && <span class="font-mono text-sm text-black/70 ml-2">{item.desc}</span>}
                            </>
                          )}
                        </div>
                        <span class:list={[
                          'font-typewriter text-lg font-bold text-red tabular-nums shrink-0',
                          block.secondaryDescriptionStyle === 'stacked' && 'mt-0.5'
                        ]}>{item.price}</span>
                      </div>
                    ))}
                  </div>
                )}

                {block.note && (
                  <p class:list={[
                    'font-mono text-sm text-black/70 mt-4',
                    (block.title === 'Café' || block.title === 'Coffee' || block.title === 'Cafè' || block.title === 'Kawa' || block.title === 'Кофе' || block.title === 'Кава' || block.title === 'Iced' || block.title === 'Freds' || block.title === 'Glacé' || block.title === 'Na zimno' || block.title === 'Со льдом' || block.title === 'Холодне') && 'text-center pt-4 border-t border-black/10 mt-8'
                  ]}>
                    {block.note}
                  </p>
                )}
              </>
            ) : (
              <div class="mt-10 mx-4 bg-red rounded-lg px-4 py-4">
                <h3 class={`font-typewriter text-xl md:text-2xl font-bold text-cream mb-3 ${block.align === 'center' ? 'text-center' : 'text-left'}`}>{block.title}</h3>
                {block.subtitle && <p class={`font-mono text-xs uppercase tracking-[0.2em] text-cream/80 ${block.align === 'center' ? 'text-center' : 'text-left'}`}>{block.subtitle}</p>}
                <div class:list={['space-y-4', block.subtitle && 'mt-4']}>
                  {block.groups.map((group) => (
                    <div>
                      {group.title && <p class={`font-typewriter text-lg font-bold text-cream ${block.align === 'center' ? 'text-center' : 'text-left'}`}>{group.title}</p>}
                      <p class={`font-mono text-sm text-cream ${block.align === 'center' ? 'text-center' : 'text-left'} ${group.title ? 'mt-1' : ''}`}>
                        {group.items.map((item, itemIndex) => (
                          <>
                            {item.label}{'\u00A0'}{item.price}
                            {itemIndex < group.items.length - 1 && <br />}
                          </>
                        ))}
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            )
          ))}
        </div>
      ))}

      <div class="mt-16 pt-8 border-t border-black/10">
        <p class="font-mono text-sm text-black/70 text-center">{view.page.footerNote}</p>
      </div>
    </div>
  </section>

  <nav class="fixed bottom-0 left-0 right-0 bg-cream border-t border-red py-5 z-50 md:hidden safe-area-bottom">
    <div class="flex justify-center items-center">
      {view.sections.map((section, index) => (
        <a
          href={`#${section.id}`}
          class:list={[
            'flex-1 flex items-center justify-center font-typewriter text-xl font-bold text-red h-14',
            index < view.sections.length - 1 && 'border-r border-red'
          ]}>
          {section.title}
        </a>
      ))}
    </div>
  </nav>
  <div class="h-20 md:hidden"></div>
</Layout>

<style>
  .tabular-nums { font-variant-numeric: tabular-nums; }
  html { scroll-behavior: smooth; }
  .safe-area-bottom { padding-bottom: max(1rem, env(safe-area-inset-bottom)); }
  .badge {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(176, 30, 27, 0.35);
    border-radius: 9999px;
    padding: 0.15rem 0.55rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: #b01e1b;
    line-height: 1;
  }
</style>
