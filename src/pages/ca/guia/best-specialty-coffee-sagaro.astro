---
import Layout from '../../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath } from '../../../i18n';

const lang = 'ca';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Inici', url: 'https://dirtyrabbit.es/ca/' },
  { name: 'Guia', url: 'https://dirtyrabbit.es/ca/guia/' },
  { name: `El Millor Cafè d'Especialitat a S'Agaró`, url: 'https://dirtyrabbit.es/ca/guia/best-specialty-coffee-sagaro' }
];
---

<Layout 
  title="El Millor Cafè d'Especialitat a S'Agaró — Dirty Rabbit 2026"
  description="El Millor Cafè d'Especialitat a S'Agaró — Dirty Rabbit, S'Agaró, Costa Brava"
  lang={lang}
  articleMeta={{ datePublished: "2026-02-15", dateModified: "2026-03-06", section: "Coffee Guide" }}
  breadcrumbs={breadcrumbs}>
  <Fragment slot="head">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CafeOrCoffeeShop",
      "name": "Dirty Rabbit",
      "url": "https://dirtyrabbit.es",
      "telephone": "+34872454264",
      "email": "hola@dirtyrabbit.es",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Avinguda Platja d'Aro 275",
        "addressLocality": "S'Agaró",
        "postalCode": "17248",
        "addressCountry": "ES"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 41.797,
        "longitude": 3.036
      },
      "openingDate": "2024-11-01",
      "amenityFeature": [
        { "@type": "LocationFeatureSpecification", "name": "WiFi", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Dog Friendly", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Terrace", "value": true }
      ],
      "servesCuisine": "Specialty Coffee",
      "description": "Cafeteria de cafè d'especialitat a S'Agaró. Espresso de La Cabra, REQ Matcha i chai Awachai. Obert el novembre de 2024."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "On és exactament el Dirty Rabbit a S'Agaró?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A l'Avinguda Platja d'Aro 275, S'Agaró, 17248. A uns cinc minuts a peu de la platja de Sant Pol."
          }
        },
        {
          "@type": "Question",
          "name": "El Dirty Rabbit és dog friendly?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. La terrassa gran és dog friendly."
          }
        },
        {
          "@type": "Question",
          "name": "Teniu WiFi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, WiFi gratuït disponible."
          }
        },
        {
          "@type": "Question",
          "name": "El cafè La Cabra es troba en algun altre lloc prop de S'Agaró?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Que sapiguem, no. La Cabra és un torrefactor d'especialitat de Barcelona. El Dirty Rabbit és el seu punt de venda en aquesta part de la Costa Brava."
          }
        },
        {
          "@type": "Question",
          "name": "Quan va obrir el Dirty Rabbit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'1 de novembre de 2024."
          }
        }
      ]
    }
  ]
}
    </script>
  </Fragment>

  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">

      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4">DIRTY RABBIT · S'AGARÓ</p>
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">
          El Millor Cafè d'Especialitat a S'Agaró
        </h1>
      </header>

      <div class="prose prose-lg max-w-none font-mono leading-relaxed">


        <div class="mt-16 p-8 bg-black text-white rounded-xl text-center">
          <p class="font-typewriter text-2xl mb-4">Dirty Rabbit</p>
          <p class="font-mono mb-6">
            Avinguda Platja d'Aro 275, S'Agaró<br>
            +34 872 454 264
          </p>
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412"
            target="_blank"
            rel="noopener noreferrer" 
            class="inline-block font-typewriter px-8 py-3 bg-red text-cream rounded-lg hover:bg-red/90 transition-colors"
          >
            Com arribar
          </a>
        </div>

      </div>
    </div>
  </article>

</Layout>
