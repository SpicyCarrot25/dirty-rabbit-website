}
    </script>
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Hi ha algun lloc a Platja d'Aro que serveixi matcha de cerimònia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Al centre de Platja d'Aro l'oferta és limitada. L'opció més propera amb matcha orgànic de qualitat és Dirty Rabbit a S'Agaró, a 10 minuts."
