---
import Layout from '../../../layouts/Layout.astro';
import { getTranslations } from '../../../i18n';

const lang = 'ca';
const t = getTranslations(lang);

const locationName = "Platja de Sant Pol";
const locationSlug = "platja-sant-pol";

const breadcrumbs = [
  { name: 'Inici', url: 'https://dirtyrabbit.es/ca/' },
  { name: 'Guia', url: 'https://dirtyrabbit.es/ca/guia/' },
  { name: `Esmorzar prop de ${locationName}`, url: `https://dirtyrabbit.es/ca/guia/esmorzar-prop-de-${locationSlug}` }
];
---

<Layout 
  title={`On esmorzar prop de ${locationName} — Guia 2026`}
  description={`Les millors adreces per esmorzar i brunchar prop de la platja de Sant Pol, entre S'Agaró i Sant Feliu. Guia local.`}
  lang={lang}
  articleMeta={{ datePublished: "2026-02-15", dateModified: "2026-03-06", section: "Coffee Guide" }}
  breadcrumbs={breadcrumbs}>

  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      
      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4">GUIA LOCAL · ESMORZAR</p>
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">
          On esmorzar prop de {locationName}
        </h1>
        <p class="font-mono text-lg text-black/70 leading-relaxed">
          La Platja de Sant Pol és una de les platges més boniques de la Costa Brava: sorra fina, aigües cristal·lines, casetes de bany històriques. I just al costat, a S'Agaró, trobaràs el millor esmorzar de la zona.
        </p>
      </header>

      <div class="prose prose-lg max-w-none">

        <section class="mb-16 p-8 bg-cream rounded-xl border-2 border-red">
          <h2 class="font-typewriter text-2xl md:text-3xl mb-4 flex items-center gap-3">
            <span class="text-3xl">🐇</span> Dirty Rabbit — L'esmorzar perfecte
          </h2>
          <p class="font-mono text-sm text-red mb-4">Avinguda Platja d'Aro 275, S'Agaró · 3 min a peu de Sant Pol</p>
          
          <p class="mb-4">
            A pocs passos de la platja, Dirty Rabbit és el lloc ideal per començar el dia. Cafè La Cabra (Dinamarca), brunch artesà, i un ambient relaxat que fa ganes de quedar-se.
          </p>
          
          <h3 class="font-typewriter text-xl mt-6 mb-3">La nostra carta d'esmorzar</h3>
          <ul class="space-y-2 mb-6">
            <li><strong>Ous Beneïts</strong> — Clàssics o amb salmó fumat</li>
            <li><strong>Bagels</strong> — Guarnicions variades, pa fresc</li>
            <li><strong>Torrades artesanes</strong> — Alvocat, ricotta, melmelada casolana...</li>
            <li><strong>Bowls</strong> — Açaí, granola, fruita fresca</li>
            <li><strong>Cafè La Cabra</strong> — Espresso, flat white, filtrat...</li>
          </ul>

          <h3 class="font-typewriter text-xl mt-6 mb-3">El matí perfecte</h3>
          <ol class="space-y-2 mb-6">
            <li><strong>8:00</strong> — Bany matinal a Sant Pol (la platja està quasi buida)</li>
            <li><strong>9:30</strong> — Esmorzar a Dirty Rabbit</li>
            <li><strong>11:00</strong> — Camí de Ronda cap a Sa Conca</li>
            <li><strong>12:30</strong> — Segon bany i relax</li>
          </ol>
          
          <p class="mb-4">
            Parlem <strong>castellà, català, anglès i polonès</strong>. Cartes en francès disponibles.
          </p>
          
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block font-typewriter text-red hover:underline"
          >
            📍 Veure a Google Maps →
          </a>
        </section>

        <section class="mb-12">
          <h2 class="font-typewriter text-2xl md:text-3xl mb-4">Altres opcions a prop</h2>
          
          <h3 class="font-typewriter text-xl mb-3">☕ Xiringuitos de Sant Pol</h3>
          <p class="mb-4">
            A l'estiu, els xiringuitos de la platja ofereixen esmorzars bàsics: cafè, torrada, suc de taronja. Còmode si no vols sortir de la sorra, però la qualitat és estàndard.
          </p>
          
          <h3 class="font-typewriter text-xl mb-3 mt-6">☕ ANNNA — Sant Feliu (7 min)</h3>
          <p class="mb-4">
            Cafè d'especialitat + fleca sense gluten en una casa preciosa del segle XIX. El seu pa de massa mare i les torrades són excel·lents. Obert dj-dl, 9h-14:30h.
          </p>
          
          <h3 class="font-typewriter text-xl mb-3 mt-6">☕ La Maglia — Platja d'Aro (8 min)</h3>
          <p class="mb-4">
            Torrador local amb gran terrassa. Bowls açaí, torrades, cafè torrat in situ. Ambient ciclista.
          </p>
        </section>

        <section class="mb-12">
          <h2 class="font-typewriter text-2xl md:text-3xl mb-4">Sobre la Platja de Sant Pol</h2>
          
          <p class="mb-4">
            Sant Pol és una platja històrica, amb les seves casetes de bany dels anys 20 encara dempeus. L'aigua és especialment clara aquí — perfecta per fer snorkel al llarg de les roques.
          </p>
          
          <ul class="space-y-2 mb-6">
            <li><strong>Pàrquing:</strong> Limitat, arriba abans de les 10h a l'estiu</li>
            <li><strong>Serveis:</strong> Hamaques, para-sols, xiringuitos (en temporada)</li>
            <li><strong>Ambient:</strong> Familiar, menys massificada que Platja d'Aro</li>
            <li><strong>Accés:</strong> Des de S'Agaró o pel Camí de Ronda des de Sant Feliu</li>
          </ul>
        </section>

        <div class="mt-16 p-8 bg-black text-white rounded-xl text-center">
          <p class="font-typewriter text-2xl mb-4">T'esperem després del bany</p>
          <p class="font-mono mb-6">
            Dirty Rabbit · Avinguda Platja d'Aro 275, S'Agaró<br>
            A 3 minuts de la platja de Sant Pol. Vine com estiguis.
          </p>
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412"
            target="_blank"
            rel="noopener noreferrer" 
            class="inline-block font-typewriter px-8 py-3 bg-red text-cream rounded-lg hover:bg-red/90 transition-colors"
          >
            Com arribar
          </a>
        </div>

      </div>
    </div>
  </article>

</Layout>
