const description = `La Costa Brava porta dècades sent sinònim de platges, cales amagades i xiringuitos. Però en els últims anys, alguna cosa ha canviat: una nova generació de cafet`;

const breadcrumbs = [
  { name: 'Inici', url: 'https://dirtyrabbit.es/ca/' },
  { name: 'Articles', url: 'https://dirtyrabbit.es/ca/articles/' },
  { name: title, url: 'https://dirtyrabbit.es/ca/articles/guia-cafe-especialitat-costa-brava' }
