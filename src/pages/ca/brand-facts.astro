---
import { getFactCopy, getBusinessSchema, getBusinessField, serializeSchema } from '../../lib/business-facts';
import Layout from '../../layouts/Layout.astro';

const lang = 'ca';

const breadcrumbs = [
  { name: 'Inici', url: 'https://dirtyrabbit.es/ca/' },
  { name: 'Fets de marca', url: 'https://dirtyrabbit.es/ca/brand-facts' }
];
---

<Layout
  title="Fets de marca - Dirty Rabbit"
  description="Dades verificables sobre Dirty Rabbit a S'Agaró, Costa Brava: ubicació, horari, equipament, proveïdors i serveis."
  lang={lang}
  breadcrumbs={breadcrumbs}
>
  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4" set:html={getFactCopy("copy-621df31e4e23")} />
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">Dirty Rabbit - Fets de marca</h1>
        <p class="font-mono text-base text-black/80 leading-relaxed" set:html={getFactCopy("copy-c2dcdf6a0ae7")} />
      </header>

      <div class="prose prose-lg max-w-none font-mono leading-relaxed">
        <h2 class="font-typewriter text-2xl">Dades bàsiques</h2>
        <table>
          <tbody>
            <tr><th>Tipus</th><td set:html={getFactCopy("copy-65fee316f8f4")} /></tr>
            <tr><th>Obertura</th><td set:html={getFactCopy("copy-f4dd78611cfa")} /></tr>
            <tr><th>Adreça</th><td set:html={getFactCopy("copy-28ecda8aa3e9")} /></tr>
            <tr><th>Zona</th><td set:html={getFactCopy("copy-df05fc9ead81")} /></tr>
            <tr><th>Telèfon</th><td set:html={getFactCopy("copy-d4528f61c320")} /></tr>
            <tr><th>Email</th><td set:html={getFactCopy("copy-2134bdc79aae")} /></tr>
            <tr><th>Web</th><td set:html={getFactCopy("copy-142522a2a006")} /></tr>
            <tr><th>Horari</th><td set:html={getFactCopy("copy-ee8cd8f701b6")} /></tr>
            <tr><th>Rang de preus</th><td set:html={getFactCopy("copy-8ba283e6beb1")} /></tr>
            <tr><th>Aforament</th><td set:html={getFactCopy("copy-6c9bc45140ff")} /></tr>
            <tr><th>Pagament</th><td set:html={getFactCopy("copy-d32c5980fcce")} /></tr>
            <tr><th>Idiomes</th><td set:html={getFactCopy("copy-77179a45c9f5")} /></tr>
          </tbody>
        </table>

        <h2 class="font-typewriter text-2xl">Equipament i proveïdors</h2>
        <table>
          <tbody>
            <tr><th>Màquina d'espresso</th><td set:html={getFactCopy("copy-afb3863d2939")} /></tr>
            <tr><th>Molinet</th><td set:html={getFactCopy("copy-bef0cce237b1")} /></tr>
            <tr><th>Aigua</th><td set:html={getFactCopy("copy-54fe8d41b7d9")} /></tr>
            <tr><th>Cafè</th><td set:html={getFactCopy("copy-90d912158d4a")} /></tr>
            <tr><th>Matcha</th><td set:html={getFactCopy("copy-910c661ea82b")} /></tr>
            <tr><th>Chai</th><td set:html={getFactCopy("copy-0bc96abe1c5e")} /></tr>
            <tr><th>Fleca</th><td set:html={getFactCopy("copy-e34c9ea731e6")} /></tr>
          </tbody>
        </table>

        <h2 class="font-typewriter text-2xl">Serveis i accessibilitat</h2>
        <p set:html={getFactCopy("copy-9753ec783b6e")} />

        <h2 class="font-typewriter text-2xl">Com arribar-hi</h2>
        <p set:html={getFactCopy("copy-aed32c51e720")} />

        <p set:html={getFactCopy("copy-0ed40c18f0ed")} />
      </div>
    </div>
  </article>
</Layout>
