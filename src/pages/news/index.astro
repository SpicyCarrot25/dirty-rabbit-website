---
import Layout from '../../layouts/Layout.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';
import { isVisiblePost } from '../../lib/demo';
import articles from '../../data/articles-es.json';

const lang = 'es';
const t = getTranslations(lang);

const allPosts = await getCollection('news', ({ data }) => {
  return data.lang === lang && isVisiblePost(data);
});

const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const lead = posts.find(post => post.slug === 'summer-guide-2026-es') || posts[0];
const rest = posts.filter(post => post !== lead);
---

<Layout title={`${t.news.title} — Dirty Rabbit`} lang={lang}>
  <section class="bg-cream">
    <div class="mz-wrap mz-page-head">
      <div class="mz-crumb"><a href="/">Dirty Rabbit</a><span>{t.news.subtitle}</span></div>
      <h1 class="font-typewriter mz-page-title text-red">{t.news.title}</h1>
    </div>

    <div class="mz-wrap">
      {posts.length === 0 ? (
        <p class="font-mono" style="padding:48px 0">No hay noticias todavía.</p>
      ) : (
        <div class="mz-newslist">
          {lead && <StoryCard lead href={`/news/${lead.slug}`} title={lead.data.title} description={lead.data.description} image={lead.data.image} date={lead.data.date} draft={lead.data.draft} kicker="Summer Guide 2026" />}
          {rest.map((post) => (
            <StoryCard href={`/news/${post.slug}`} title={post.data.title} description={post.data.description} image={post.data.image} date={post.data.date} draft={post.data.draft} />
          ))}
        </div>
      )}

      <div class="mz-section-head" style="margin-top:8px">
        <h2 style="font-size:40px">Del archivo</h2>
        <p>Artículos</p>
      </div>
      <div class="mz-hub" style="padding-top:0">
        {articles.map(article => (
          <a href={article.href}><span>Artículo</span><strong>{article.title}</strong></a>
        ))}
      </div>
    </div>
  </section>
</Layout>
