---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';
import { isVisiblePost } from '../../lib/demo';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => data.lang === 'es' && isVisiblePost(data));
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const lang = post.data.lang || 'es';
const t = getTranslations(lang);
const dateLabel = post.data.date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={`${post.data.title} — Dirty Rabbit`} description={post.data.description} lang={lang} noindex={post.data.draft}>
  <article class="bg-cream">
    <header class="mz-wrap mz-page-head">
      <div class="mz-crumb">
        <a href="/news">← Volver a noticias</a>
        <span><time datetime={post.data.date.toISOString().slice(0, 10)}>{dateLabel}</time>{post.data.draft && <span class="mz-draft-flag">Borrador · demo</span>}</span>
      </div>
      <h1 class="font-typewriter mz-page-title">{post.data.title}</h1>
      <p class="mz-page-dek">{post.data.description}</p>
    </header>

    <div class="mz-wrap mz-article">
      <div class="mz-article-body">
        {post.data.image && (
          <figure class="mz-article-photo">
            <img src={post.data.image} alt={post.data.title} />
          </figure>
        )}
        <div class="prose max-w-none" data-seasonal-status={post.body.includes('Fitzroy') ? 'fitzroy' : undefined}>
          <Content />
        </div>
      </div>
      <aside class="mz-aside">
        <div class="mz-box">
          <h2>Dirty Rabbit</h2>
          <p>Café La Cabra, desayunos y brunch. Mar–Dom 8:00–15:00; lunes cerrado.</p>
          <a class="mz-btn mz-btn--solid" href="https://www.google.com/maps?cid=13237319999262880412" target="_blank" rel="noopener noreferrer">Ver en Google Maps</a>
        </div>
        <div class="mz-box">
          <h2>Seguir leyendo</h2>
          <ul>
            <li><a href="/news">{t.news.title}</a></li>
            <li><a href="/carta">Carta</a></li>
            <li><a href="/guia/">Guías locales</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
</Layout>
