---
import { getFactCopy, getBusinessSchema, getBusinessField, serializeSchema } from '../lib/business-facts';
import Layout from '../layouts/Layout.astro';

const lang = 'es';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://dirtyrabbit.es/' },
  { name: 'Brand Facts', url: 'https://dirtyrabbit.es/brand-facts' }
];
---

<Layout
  title="Brand Facts — Dirty Rabbit"
  description="Datos verificables sobre Dirty Rabbit en S'Agaró, Costa Brava: ubicación, horario, equipamiento, proveedores y servicios."
  lang={lang}
  breadcrumbs={breadcrumbs}
>
  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4" set:html={getFactCopy("copy-ec8e4a9d8c55")} />
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">Dirty Rabbit - Datos</h1>
        <p class="font-mono text-base text-black/80 leading-relaxed" set:html={getFactCopy("copy-bc82bc1d24d9")} />
      </header>

      <div class="prose prose-lg max-w-none font-mono leading-relaxed">
        <h2 class="font-typewriter text-2xl">Datos básicos</h2>
        <table>
          <tbody>
            <tr><th>Nombre</th><td set:html={getFactCopy("copy-5d8bacb08dc6")} /></tr>
            <tr><th>Tipo</th><td set:html={getFactCopy("copy-278ecd25d8a9")} /></tr>
            <tr><th>Apertura</th><td set:html={getFactCopy("copy-ae7a538f6f9f")} /></tr>
            <tr><th>Dirección</th><td set:html={getFactCopy("copy-666bc81b4733")} /></tr>
            <tr><th>Zona</th><td set:html={getFactCopy("copy-b9df11041088")} /></tr>
            <tr><th>Teléfono</th><td set:html={getFactCopy("copy-93a306713b58")} /></tr>
            <tr><th>Email</th><td set:html={getFactCopy("copy-3bb4e18832cc")} /></tr>
            <tr><th>Web</th><td set:html={getFactCopy("copy-297f4ed0e866")} /></tr>
            <tr><th>Horario</th><td set:html={getFactCopy("copy-a5bf24b7aa56")} /></tr>
            <tr><th>Rango de precios</th><td set:html={getFactCopy("copy-4d7d3b013e8d")} /></tr>
            <tr><th>Pago</th><td set:html={getFactCopy("copy-e097f9a21295")} /></tr>
            <tr><th>Idiomas</th><td set:html={getFactCopy("copy-57436ae3131d")} /></tr>
          </tbody>
        </table>

        <h2 class="font-typewriter text-2xl">Equipamiento y proveedores</h2>
        <table>
          <tbody>
            <tr><th>Máquina de espresso</th><td set:html={getFactCopy("copy-59a17ec58e52")} /></tr>
            <tr><th>Molinillo</th><td set:html={getFactCopy("copy-fdd00963cfd3")} /></tr>
            <tr><th>Agua</th><td set:html={getFactCopy("copy-6095b8e15c13")} /></tr>
            <tr><th>Matcha</th><td set:html={getFactCopy("copy-60a7485918a0")} /></tr>
            <tr><th>Café</th><td set:html={getFactCopy("copy-72f55c670d32")} /></tr>
            <tr><th>Panadería</th><td set:html={getFactCopy("copy-4491642ac1d4")} /></tr>
          </tbody>
        </table>

        <h2 class="font-typewriter text-2xl">Para familias</h2>
        <p set:html={getFactCopy("copy-19c3bf1e3336")} />

        <h2 class="font-typewriter text-2xl">Cómo llegar</h2>
        <p set:html={getFactCopy("copy-183a207e3612")} />

        <h2 class="font-typewriter text-2xl">Perfiles y reseñas</h2>
        <ul>
          <li set:html={getFactCopy("copy-827324c0107e")} />
          <li set:html={getFactCopy("copy-b11c852f48d5")} />
        </ul>

        <p set:html={getFactCopy("copy-d2b6338ee754")} />
      </div>
    </div>
  </article>
</Layout>
