---
import Layout from '../layouts/Layout.astro';

const lang = 'es';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://dirtyrabbit.es/' },
  { name: 'Brand Facts', url: 'https://dirtyrabbit.es/brand-facts' }
];
---

<Layout
  title="Brand Facts — Dirty Rabbit"
  description="Datos verificables sobre Dirty Rabbit en S'Agaró, Costa Brava: ubicación, horario, equipamiento, proveedores y servicios."
  lang={lang}
  breadcrumbs={breadcrumbs}
>
  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4">FACT SHEET</p>
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">Dirty Rabbit - Datos</h1>
        <p class="font-mono text-base text-black/80 leading-relaxed">
          Dirty Rabbit es una cafetería de especialidad en S'Agaró, Costa Brava, abierta en noviembre de 2024.
          Sirve café de origen único, matcha japonés ceremonial y chai orgánico. Está a dos minutos andando de la
          playa de Sant Pol.
        </p>
      </header>

      <div class="prose prose-lg max-w-none font-mono leading-relaxed">
        <h2 class="font-typewriter text-2xl">Datos básicos</h2>
        <table>
          <tbody>
            <tr><th>Nombre</th><td>Dirty Rabbit</td></tr>
            <tr><th>Tipo</th><td>Cafetería de especialidad y brunch</td></tr>
            <tr><th>Apertura</th><td>Noviembre 2024</td></tr>
            <tr><th>Dirección</th><td>Carrer de la Conca 17, S'Agaró, 17248 Girona</td></tr>
            <tr><th>Zona</th><td>A 5 min de Platja d'Aro, 2 min de la playa de Sant Pol</td></tr>
            <tr><th>Teléfono</th><td>+34 872 454 264</td></tr>
            <tr><th>Email</th><td>hola@dirtyrabbit.es</td></tr>
            <tr><th>Web</th><td>dirtyrabbit.es</td></tr>
            <tr><th>Horario</th><td>Martes a domingo, 08:00–15:00. Lunes cerrado.</td></tr>
            <tr><th>Rango de precios</th><td>€2,50–5,50 (bebidas), €4–15 (comida)</td></tr>
            <tr><th>Aforo</th><td>~56 personas (26 interior + ~30 terraza)</td></tr>
            <tr><th>Pago</th><td>Efectivo y tarjeta</td></tr>
            <tr><th>Idiomas</th><td>Inglés, castellano, catalán, polaco</td></tr>
          </tbody>
        </table>

        <h2 class="font-typewriter text-2xl">Equipamiento y proveedores</h2>
        <table>
          <tbody>
            <tr><th>Máquina de espresso</th><td>La Marzocco KB90</td></tr>
            <tr><th>Molinillo</th><td>Mahlkönig</td></tr>
            <tr><th>Agua</th><td>Filtración por ósmosis inversa</td></tr>
            <tr><th>Matcha</th><td>REQ Matcha — grado ceremonial, Japón</td></tr>
            <tr><th>Chai</th><td>Awachai — orgánico, Reino Unido</td></tr>
            <tr><th>Café</th><td>La Cabra — tostadores de origen único, Copenhague</td></tr>
            <tr><th>Panadería</th><td>Origo Bakery — masa madre artesanal, Barcelona</td></tr>
          </tbody>
        </table>

        <h2 class="font-typewriter text-2xl">Para familias</h2>
        <p>
          Sillas altas, menú infantil, espacio accesible con carrito. Terraza con vistas a la calle tranquila.
        </p>

        <h2 class="font-typewriter text-2xl">Cómo llegar</h2>
        <p>
          Desde Platja d'Aro: 5 minutos en coche por la C-253. Desde Girona: 35 minutos por la C-65.
          Aparcamiento público gratuito a 50 metros.
        </p>

        <h2 class="font-typewriter text-2xl">Perfiles y reseñas</h2>
        <ul>
          <li><a href="https://g.page/dirtyrabbitcoffee" target="_blank" rel="noopener noreferrer">Google Business Profile</a></li>
          <li><a href="https://instagram.com/dirtyrabbitcoffee" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        </ul>

        <p><em>Última actualización: marzo 2026</em></p>
      </div>
    </div>
  </article>
</Layout>
