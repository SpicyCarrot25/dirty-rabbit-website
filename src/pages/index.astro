---
import Layout from '../layouts/Layout.astro';
import CuratedList from '../components/CuratedList.astro';
import StoryCard from '../components/StoryCard.astro';
import { getLocalizedPath } from '../i18n';
import { getCollection } from 'astro:content';
import { getFactCopy } from '../lib/business-facts';
import { isVisiblePost, SHOW_DEMO_DRAFTS } from '../lib/demo';
import proveedores from '../data/proveedores.json';

const lang = 'es';

// Featured providers for homepage (curated selection)
const featuredIds = ['la-cabra', 'origo-bakery', 'la-puntual', 'buddy-buddy'];
const featuredProviders = featuredIds.map(id => proveedores.find(p => p.id === id)).filter(Boolean);

// One featured story: the Summer Guide on the demo preview, otherwise the latest published post.
const allNews = await getCollection('news', ({ data }) => data.lang === lang && isVisiblePost(data));
const sortedNews = allNews.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const summerGuide = sortedNews.find(post => post.slug === 'summer-guide-2026-es');
const leadPost = summerGuide || sortedNews[0];
const storyHref = summerGuide && SHOW_DEMO_DRAFTS ? `/news/${summerGuide.slug}/` : undefined;
---

<Layout
  title="Dirty Rabbit: cafetería que admite perros en S’Agaró"
  description="Café La Cabra, desayuno y brunch en S’Agaró, Costa Brava. Perros bienvenidos, terraza de 56 plazas y WiFi gratis, a 2 minutos a pie de Sant Pol."
  lang={lang}>

  <h1 class="sr-only">Dirty Rabbit — Specialty Coffee y Brunch en S'Agaró, Costa Brava</h1>

  <!-- COVER: headline + photo, one intro line, hours + Carta + Pide Ahora -->
  <section class="mz-wrap" aria-label="Portada">
    <div class="mz-issue">
      <span>Specialty coffee · Desayuno · Brunch</span>
      <span>Perros bienvenidos</span>
    </div>
    <div class="mz-cover">
      <p class="mz-cover-title">Mañanas tranquilas. Risas fáciles. Coffee in between.</p>
      <figure class="mz-cover-photo">
        <img src="/gallery/elm.murcia_dirtyrabbit-207.jpg" alt="Interior de Dirty Rabbit cafetería specialty coffee Costa Brava" fetchpriority="high" />
      </figure>
      <div class="mz-cover-info">
        <p class="mz-cover-dek">Café La Cabra, desayunos y brunch, con terraza de 56 plazas.</p>
        <div class="mz-hours">
          <b>Horario</b>
          <span set:html={getFactCopy("copy-3e2ab0f46a17")} />
          <small>Lunes cerrado.</small>
        </div>
        <div class="mz-btns">
          <a href={getLocalizedPath('/carta', lang)} class="mz-btn">Carta</a>
          <a href="https://order.dirtyrabbit.es" target="_blank" rel="noopener noreferrer" class="mz-btn mz-btn--solid">Pide Ahora</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CURATED LIST (2026 Summer Guide) -->
  <CuratedList storyHref={storyHref} />

  <!-- ONE FEATURED STORY -->
  {leadPost && (
    <section class="mz-section" aria-labelledby="news-title">
      <div class="mz-wrap">
        <div class="mz-section-head">
          <h2 id="news-title">News y Momentos</h2>
          <a href={getLocalizedPath('/news', lang)} class="mz-more">Ver todas las noticias →</a>
        </div>
        <div class="mz-feature">
          <StoryCard lead href={`/news/${leadPost.slug}/`} title={leadPost.data.title} description={leadPost.data.description} image={leadPost.data.image} date={leadPost.data.date} draft={leadPost.data.draft} kicker="Summer Guide 2026" />
        </div>
      </div>
    </section>
  )}

  <!-- COMPACT SUPPLIERS STRIP -->
  <section class="mz-section mz-section--tight" aria-labelledby="providers-title">
    <div class="mz-wrap">
      <div class="mz-strip-head">
        <h2 id="providers-title">Proveedores</h2>
        <a href={getLocalizedPath('/proveedores', lang)} class="mz-more">Ver todos →</a>
      </div>
      <ul class="mz-strip">
        {featuredProviders.map((p: any) => (
          <li>
            <img src={p.image || `/images/proveedores/${p.id}.jpg`} alt={`dirty-rabbit-proveedor-${p.id}-${p.origin?.toLowerCase().replace(/\s+/g, '-') || 'local'}`} loading="lazy" />
            <span><strong>{p.name}</strong><small>{p.origin || ''}</small></span>
          </li>
        ))}
      </ul>
      <p class="mz-guides-link"><a href="/guia/" class="mz-more">Guías locales →</a></p>
    </div>
  </section>
</Layout>
