---
import Layout from '../layouts/Layout.astro';
import CuratedList from '../components/CuratedList.astro';
import StoryCard from '../components/StoryCard.astro';
import { getTranslations, getLocalizedPath } from '../i18n';
import { getCollection } from 'astro:content';
import { getFactCopy, getWinterNotice } from '../lib/business-facts';
import { isVisiblePost, SHOW_DEMO_DRAFTS } from '../lib/demo';
import proveedores from '../data/proveedores.json';
import articles from '../data/articles-es.json';

const lang = 'es';
const t = getTranslations(lang);
const winterNotice = getWinterNotice(lang);

// Featured providers for homepage (curated selection)
const featuredIds = ['la-cabra', 'origo-bakery', 'la-puntual', 'buddy-buddy'];
const featuredProviders = featuredIds.map(id => proveedores.find(p => p.id === id)).filter(Boolean);

// Latest news posts for this language (approval-only drafts appear only in the demo preview)
const allNews = await getCollection('news', ({ data }) => data.lang === lang && isVisiblePost(data));
const sortedNews = allNews.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const summerGuide = sortedNews.find(post => post.slug === 'summer-guide-2026-es');
const leadPost = summerGuide || sortedNews[0];
const otherPosts = sortedNews.filter(post => post !== leadPost).slice(0, 3);
const storyHref = summerGuide && SHOW_DEMO_DRAFTS ? `/news/${summerGuide.slug}/` : undefined;

const gallery = [
  { src: '/gallery/elm.murcia_dirtyrabbit-44.jpg', alt: "Croissant y latte con arte en Dirty Rabbit S'Agaró" },
  { src: '/gallery/elm.murcia_dirtyrabbit-125.jpg', alt: 'Tostada de salmón y aguacate con matcha latte en Dirty Rabbit' },
  { src: '/gallery/dirty-rabbit-cafe-interior-4.jpg', alt: "Barra de café con La Marzocco KB90 en Dirty Rabbit S'Agaró" },
  { src: '/gallery/dirty-rabbit-specialty-coffee-2.jpg', alt: 'Café de especialidad La Cabra servido en Dirty Rabbit' },
  { src: '/gallery/dirty-rabbit-brunch-sagaro-2.jpg', alt: "Bikini de queso fundido brunch en Dirty Rabbit S'Agaró" },
  { src: '/images/heroes/nosotros.jpg', alt: 'Café servido en la barra de Dirty Rabbit' },
];

const guides = [
  { href: '/guia/brunch-platja-daro', title: 'Brunch en Platja d’Aro: una escapada a S’Agaró' },
  { href: '/guia/mejor-cafe-costa-brava', title: 'Café de especialidad en la Costa Brava' },
  { href: '/guia/cafeteria-admite-perros-costa-brava', title: 'Cafetería que admite perros en la Costa Brava' },
  { href: '/guia/que-hacer-en-sagaro', title: 'Qué ver en S’Agaró: Sant Pol y Camí de Ronda' },
];
---

<Layout
  title="Dirty Rabbit: cafetería que admite perros en S’Agaró"
  description="Café La Cabra, desayuno y brunch en S’Agaró, Costa Brava. Perros bienvenidos, terraza de 56 plazas y WiFi gratis, a 2 minutos a pie de Sant Pol."
  lang={lang}>

  <h1 class="sr-only">Dirty Rabbit — Specialty Coffee y Brunch en S'Agaró, Costa Brava</h1>

  <!-- COVER -->
  <section class="mz-wrap" aria-label="Portada">
    <div class="mz-issue">
      <span>Specialty coffee · Desayuno · Brunch</span>
      <span>Mar–Dom 8:00–15:00</span>
    </div>
    <div class="mz-cover">
      <p class="mz-cover-title">Mañanas tranquilas. Risas fáciles. Coffee in between.</p>
      <figure class="mz-cover-photo">
        <img src="/gallery/elm.murcia_dirtyrabbit-207.jpg" alt="Interior de Dirty Rabbit cafetería specialty coffee Costa Brava" fetchpriority="high" />
      </figure>
      <p class="mz-cover-dek">Café La Cabra, desayunos y brunch. <strong>Perros bienvenidos</strong>, terraza de 56 plazas y WiFi gratis.</p>
    </div>
  </section>

  <!-- COMMUNITY / EDITOR'S LETTER -->
  <section class="mz-wrap">
    <div class="mz-intro">
      <p class="mz-intro-copy">
        La familia con el niño que no para. La pareja que viene desde el primer día. El que acaba de mudarse y no conoce a nadie todavía. Aquí se viene a desayunar bien, a tomar café de verdad, y a quedarse un rato. Desconocidos que se vuelven clientes que se vuelven amigos. <a href={getLocalizedPath('/carta', lang)}>Specialty coffee</a>, brunch y desayunos yummy en S'Agaró, en el corazón de la Costa Brava.
      </p>
      <aside class="mz-intro-aside">
        <div class="mz-btns">
          <a href={getLocalizedPath('/carta', lang)} class="mz-btn">Carta</a>
          <a href="https://order.dirtyrabbit.es" target="_blank" rel="noopener noreferrer" class="mz-btn mz-btn--solid">Pide Ahora</a>
        </div>
        <div class="mz-hours">
          <b>Horario</b>
          <span set:html={getFactCopy("copy-3e2ab0f46a17")} />
          <small>Lunes cerrado.</small>
          {winterNotice && <small>{winterNotice}</small>}
        </div>
      </aside>
    </div>
  </section>

  <!-- PHOTO GRID -->
  <section class="mz-wrap" aria-label="Fotos">
    <div class="mz-gallery">
      {gallery.map((photo, i) => (
        <figure><img src={photo.src} alt={photo.alt} loading={i < 2 ? 'eager' : 'lazy'} /></figure>
      ))}
    </div>
  </section>

  <!-- CURATED LIST (2026 Summer Guide) -->
  <CuratedList storyHref={storyHref} />

  <!-- NEWS -->
  <section class="mz-section" aria-labelledby="news-title">
    <div class="mz-wrap">
      <div class="mz-section-head">
        <h2 id="news-title">News y Momentos</h2>
        <p>Lo último de Dirty Rabbit</p>
      </div>
      <div class="mz-news-grid">
        {leadPost && (
          <StoryCard lead href={`/news/${leadPost.slug}/`} title={leadPost.data.title} description={leadPost.data.description} image={leadPost.data.image} date={leadPost.data.date} draft={leadPost.data.draft} kicker="Summer Guide 2026" />
        )}
        <div class="mz-news-side">
          {otherPosts.map(post => (
            <StoryCard href={`/news/${post.slug}/`} title={post.data.title} description={post.data.description} image={post.data.image} date={post.data.date} draft={post.data.draft} />
          ))}
          <div>
            <p class="mz-kicker" style="margin-bottom:6px">Del archivo</p>
            <div class="mz-story-list">
              {articles.slice(0, 4).map(article => (
                <a href={article.href}><span>Artículo</span><strong>{article.title}</strong></a>
              ))}
            </div>
          </div>
          <a href={getLocalizedPath('/news', lang)} class="mz-more">Ver todas las noticias →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PROVIDERS -->
  <section class="mz-section" aria-labelledby="providers-title">
    <div class="mz-wrap">
      <div class="mz-section-head">
        <h2 id="providers-title">Proveedores</h2>
        <p>La gente detrás de tu taza</p>
      </div>
      <div class="mz-producers">
        {featuredProviders.map((p: any) => (
          <article class="mz-producer">
            <img src={p.image || `/images/proveedores/${p.id}.jpg`} alt={`dirty-rabbit-proveedor-${p.id}-${p.origin?.toLowerCase().replace(/\s+/g, '-') || 'local'}`} loading="lazy" />
            <div>
              <p>{(p.category as any)[lang]}</p>
              <h3>{p.name}</h3>
              <p>{p.origin || ''}</p>
            </div>
          </article>
        ))}
      </div>
      <a href={getLocalizedPath('/proveedores', lang)} class="mz-more" style="margin-top:14px">Ver todos los proveedores →</a>
    </div>
  </section>

  <!-- ABOUT + GUIDES -->
  <section class="mz-section" aria-labelledby="about-title">
    <div class="mz-wrap">
      <div class="mz-section-head">
        <h2 id="about-title">Sobre Dirty Rabbit</h2>
        <p>Café, terraza y bienvenida</p>
      </div>
      <div class="mz-about">
        <div>
          <div class="mz-about-copy">
            <p data-speakable>
        Dirty Rabbit es un café de especialidad en S'Agaró, en la Costa Brava, a dos minutos andando de la playa de Sant Pol. Abierto desde noviembre de 2024, servimos espresso de origen único tostado por La Cabra (Copenhague), matcha ceremonial japonés de REQ, chai orgánico de Awachai, y bollería artesana de Origo Bakery (Barcelona) y La Puntual (Girona). Preparado en una La Marzocco KB90 con agua filtrada por ósmosis inversa.
      </p>
            <p>
        Terraza familiar con 56 plazas, tronas, cambiador, y bienvenida a perros. WiFi gratis, pago con tarjeta, y todo disponible para llevar. El setup de café más completo de la Costa Brava.
      </p>
          </div>
          <figure class="mz-film" style="margin-top:20px">
            <video autoplay muted loop playsinline preload="metadata" disablePictureInPicture aria-label="La Marzocco en Dirty Rabbit">
              <source src="/photos/hero-video.mp4" type="video/mp4" />
            </video>
          </figure>
        </div>
        <nav class="mz-guides" aria-label="Guías locales">
          <h3>Guías locales</h3>
          {guides.map(guide => (
            <a class="mz-guide-link" href={guide.href}>{guide.title} <span aria-hidden="true">→</span></a>
          ))}
          <a href="/guia/" class="mz-more" style="margin-top:8px">Todas las guías →</a>
        </nav>
      </div>
    </div>
  </section>

  <h1 class="sr-only">Dirty Rabbit — Specialty Coffee, Breakfast &amp; Brunch en S'Agaró, Costa Brava</h1>
</Layout>
