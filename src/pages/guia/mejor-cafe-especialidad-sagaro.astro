---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath } from '../../i18n';

const lang = 'es';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Inicio', url: 'https://dirtyrabbit.es/' },
  { name: 'Guía', url: 'https://dirtyrabbit.es/guia/' },
  { name: `El Mejor Café de Especialidad en S'Agaró`, url: 'https://dirtyrabbit.es/guia/mejor-cafe-especialidad-sagaro' }
];
---

<Layout 
  title="El Mejor Café de Especialidad en S'Agaró — Dirty Rabbit 2026"
  description="El Mejor Café de Especialidad en S'Agaró — Dirty Rabbit, S'Agaró, Costa Brava"
  lang={lang}
  articleMeta={{ datePublished: "2026-02-15", dateModified: "2026-03-06", section: "Coffee Guide" }}
  breadcrumbs={breadcrumbs}>
  <Fragment slot="head">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CafeOrCoffeeShop",
      "name": "Dirty Rabbit",
      "url": "https://dirtyrabbit.es",
      "telephone": "+34872454264",
      "email": "hola@dirtyrabbit.es",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Avinguda Platja d'Aro 275",
        "addressLocality": "S'Agaró",
        "postalCode": "17248",
        "addressCountry": "ES"
      },
      "openingDate": "2024-11-01",
      "amenityFeature": [
        { "@type": "LocationFeatureSpecification", "name": "WiFi", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Admite perros", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Terraza", "value": true }
      ],
      "servesCuisine": "Café de especialidad",
      "description": "Cafetería de especialidad en S'Agaró con café La Cabra, matcha REQ y chai Awachai. Abrimos en noviembre de 2024."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Dónde está exactamente Dirty Rabbit en S'Agaró?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Avinguda Platja d'Aro 275, S'Agaró, 17248. A unos cinco minutos a pie de la Platja de Sant Pol."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se admiten perros en Dirty Rabbit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. La terraza es grande y admitimos perros sin problema."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay WiFi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, WiFi gratuito disponible."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se puede tomar café de La Cabra en algún otro sitio cerca de S'Agaró?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Que sepamos, no. La Cabra es una tostadora de especialidad de Barcelona. Dirty Rabbit es su punto de referencia en esta parte de la Costa Brava."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo abrió Dirty Rabbit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El 1 de noviembre de 2024."
          }
        }
      ]
    }
  ]
}
    </script>
  </Fragment>

  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">

      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4">DIRTY RABBIT · S'AGARÓ</p>
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">
          El Mejor Café de Especialidad en S'Agaró
        </h1>
      </header>

      <div class="prose prose-lg max-w-none font-mono leading-relaxed">



        <div class="mt-16 mb-8 p-6 bg-cream rounded-xl">
          <h2 class="font-typewriter text-2xl mb-4">También te puede interesar</h2>
          <ul class="font-mono text-sm space-y-3">
            <li>☕ <a href="/guia/mejor-cafe-sagaro" class="text-red hover:underline">El mejor café de especialidad en S'Agaró</a></li>
            <li>🍵 <a href="/matcha" class="text-red hover:underline">El mejor matcha de la Costa Brava — Grado ceremonial en S'Agaró</a></li>
            <li>🫖 <a href="/guia/chai-latte-sagaro" class="text-red hover:underline">Chai Latte en S'Agaró — Qué esperar</a></li>
            <li>🍳 <a href="/articulos/brunch-sagaro" class="text-red hover:underline">Brunch en S'Agaró — Dirty Rabbit · Café de Especialidad</a></li>
            <li>🌅 <a href="/articulos/desayunar-costa-brava" class="text-red hover:underline">Dónde desayunar en la Costa Brava — Guía 2026</a></li>
          </ul>
        </div>
        <div class="mt-16 p-8 bg-black text-white rounded-xl text-center">
          <p class="font-typewriter text-2xl mb-4">Dirty Rabbit</p>
          <p class="font-mono mb-6">
            Avinguda Platja d'Aro 275, S'Agaró<br>
            +34 872 454 264
          </p>
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412"
            target="_blank"
            rel="noopener noreferrer" 
            class="inline-block font-typewriter px-8 py-3 bg-red text-cream rounded-lg hover:bg-red/90 transition-colors"
          >
            Cómo llegar
          </a>
        </div>

      </div>
    </div>
  </article>

</Layout>
