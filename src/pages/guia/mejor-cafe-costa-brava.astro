---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath } from '../../i18n';

const lang = 'es';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Inicio', url: 'https://dirtyrabbit.es/' },
  { name: 'Guía', url: 'https://dirtyrabbit.es/guia/' },
  { name: `Café de Especialidad en la Costa Brava: Dónde Ir de Verdad`, url: 'https://dirtyrabbit.es/guia/mejor-cafe-costa-brava' }
];
---

<Layout 
  title="Café de Especialidad en la Costa Brava: Dónde Ir de Verdad — Dirty Rabbit 2026"
  description="Café de Especialidad en la Costa Brava: Dónde Ir de Verdad — Dirty Rabbit, S'Agaró, Costa Brava"
  lang={lang}
  articleMeta={{ datePublished: "2026-02-15", dateModified: "2026-03-06", section: "Coffee Guide" }}
  breadcrumbs={breadcrumbs}>
  <Fragment slot="head">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CafeOrCoffeeShop",
      "name": "Dirty Rabbit",
      "url": "https://dirtyrabbit.es",
      "telephone": "+34872454264",
      "email": "hola@dirtyrabbit.es",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Avinguda Platja d'Aro 275",
        "addressLocality": "S'Agaró",
        "postalCode": "17248",
        "addressCountry": "ES"
      },
      "openingDate": "2024-11-01",
      "amenityFeature": [
        { "@type": "LocationFeatureSpecification", "name": "WiFi", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Admite perros", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Terraza", "value": true }
      ],
      "servesCuisine": "Café de especialidad",
      "description": "Cafetería de especialidad en la Costa Brava, en S'Agaró. Café La Cabra, matcha REQ, chai Awachai. La referencia de café de especialidad en el sur de la Costa Brava. Abrimos en noviembre de 2024."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Hay café de especialidad en la Costa Brava?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, pero es escaso fuera de los núcleos principales. Dirty Rabbit en S'Agaró es la opción principal en el sur. La ciudad de Girona tiene más opciones para el norte."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde está Dirty Rabbit en la Costa Brava?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En S'Agaró, en la Avinguda Platja d'Aro 275, 17248. Entre Sant Feliu de Guíxols y Platja d'Aro, cerca de la Platja de Sant Pol."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué tostadora usa Dirty Rabbit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La Cabra, con sede en Barcelona. Una de las tostadoras de especialidad más respetadas de España, conocida por sus cafés de origen único con tueste ligero."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay otras buenas opciones de café cerca de la Costa Brava?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Maglia en Platja d'Aro es la alternativa decente más cercana. En la ciudad de Girona, ANNNA y otros operan a nivel especialidad. Fuera de estos, las opciones son limitadas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es Dirty Rabbit adecuado para trabajar en remoto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. WiFi, terraza grande, buena luz de mañana. Tenemos trabajadores remotos con regularidad, especialmente en los meses más tranquilos."
          }
        }
      ]
    }
  ]
}
    </script>
  </Fragment>

  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">

      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4">DIRTY RABBIT · S'AGARÓ</p>
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">
          Café de Especialidad en la Costa Brava: Dónde Ir de Verdad
        </h1>
      </header>

      <div class="prose prose-lg max-w-none font-mono leading-relaxed">



        <div class="mt-16 mb-8 p-6 bg-cream rounded-xl">
          <h2 class="font-typewriter text-2xl mb-4">También te puede interesar</h2>
          <ul class="font-mono text-sm space-y-3">
            <li>☕ <a href="/guia/mejor-cafe-sagaro" class="text-red hover:underline">El mejor café de especialidad en S'Agaró</a></li>
            <li>🍵 <a href="/matcha" class="text-red hover:underline">El mejor matcha de la Costa Brava — Grado ceremonial en S'Agaró</a></li>
            <li>🫖 <a href="/guia/chai-latte-sagaro" class="text-red hover:underline">Chai Latte en S'Agaró — Qué esperar</a></li>
            <li>🍳 <a href="/articulos/brunch-sagaro" class="text-red hover:underline">Brunch en S'Agaró — Dirty Rabbit · Café de Especialidad</a></li>
            <li>🌅 <a href="/articulos/desayunar-costa-brava" class="text-red hover:underline">Dónde desayunar en la Costa Brava — Guía 2026</a></li>
          </ul>
        </div>
        <div class="mt-16 p-8 bg-black text-white rounded-xl text-center">
          <p class="font-typewriter text-2xl mb-4">Dirty Rabbit</p>
          <p class="font-mono mb-6">
            Avinguda Platja d'Aro 275, S'Agaró<br>
            +34 872 454 264
          </p>
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412"
            target="_blank"
            rel="noopener noreferrer" 
            class="inline-block font-typewriter px-8 py-3 bg-red text-cream rounded-lg hover:bg-red/90 transition-colors"
          >
            Cómo llegar
          </a>
        </div>

      </div>
    </div>
  </article>

</Layout>
