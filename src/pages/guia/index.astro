---
import Layout from '../../layouts/Layout.astro';

const lang = 'es';
const title = 'Guías de Café y Brunch en la Costa Brava — Dirty Rabbit';
const description = 'Guías completas sobre café de especialidad, matcha, chai y los mejores lugares para desayunar en la Costa Brava.';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://dirtyrabbit.es/' },
  { name: 'Guía', url: 'https://dirtyrabbit.es/guia/' }
];

const guideFiles = Object.keys(import.meta.glob('./*.astro'))
  .filter((pagePath) => !pagePath.endsWith('/index.astro'))
  .sort();

const formatGuideTitle = (slug: string) => {
  const baseTitle = slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

  return [
    ['Platja Daro', "Platja d'Aro"],
    ['Sagaro', "S'Agaró"],
    ['Sant Feliu De Guixols', 'Sant Feliu de Guíxols'],
    ['Cami De Ronda', 'Camí de Ronda'],
    ['Costa Brava', 'Costa Brava'],
    ['Cafe', 'Café'],
    ['Wifi', 'WiFi'],
    [' De ', ' de '],
    [' Del ', ' del '],
    [' La ', ' la '],
    [' Las ', ' las '],
    [' El ', ' el '],
    [' En ', ' en '],
    [' Y ', ' y ']
  ].reduce((result, [from, to]) => result.replaceAll(from, to), baseTitle);
};

const guideLinks = guideFiles.map((pagePath) => {
  const slug = pagePath.replace('./', '').replace('.astro', '');
  return {
    href: '/guia/' + slug,
    slug,
    title: formatGuideTitle(slug)
  };
});
---

<Layout
  title={title}
  description={description}
  lang={lang}
  breadcrumbs={breadcrumbs}>
  <section class="bg-cream">
    <div class="mz-wrap mz-page-head">
      <div class="mz-crumb"><a href="/">Dirty Rabbit</a><span>Guías</span></div>
      <h1 class="font-typewriter mz-page-title text-red">{title}</h1>
      <p class="mz-page-dek font-mono">
        Una vista rápida de todas nuestras guías locales sobre specialty coffee, matcha, chai y desayunos por S'Agaró, Platja d'Aro, Sant Feliu y el resto de la Costa Brava.
      </p>
    </div>
    <div class="mz-wrap">
      <div class="mz-hub">
        {guideLinks.map((guide) => (
          <a href={guide.href}>
            <span>{guide.slug}</span>
            <strong>{guide.title}</strong>
          </a>
        ))}
      </div>
      <p class="font-mono" style="padding-bottom:40px"><a class="text-red underline" href="/nl/gids/ontbijt-platja-d-aro/" lang="nl">Ontbijt bij Platja d’Aro — guía en neerlandés</a></p>
    </div>
  </section>
</Layout>
