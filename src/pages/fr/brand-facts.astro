---
import { getFactCopy, getBusinessSchema, getBusinessField, serializeSchema } from '../../lib/business-facts';
import Layout from '../../layouts/Layout.astro';

const lang = 'fr';

const breadcrumbs = [
  { name: 'Accueil', url: 'https://dirtyrabbit.es/fr/' },
  { name: 'Fiche de marque', url: 'https://dirtyrabbit.es/fr/brand-facts' }
];
---

<Layout
  title="Fiche d'identite - Dirty Rabbit"
  description="Informations vérifiables sur Dirty Rabbit à S'Agaró, Costa Brava : emplacement, horaires, équipement, fournisseurs et services."
  lang={lang}
  breadcrumbs={breadcrumbs}
>
  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4" set:html={getFactCopy("copy-9fa4442b3759")} />
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">Dirty Rabbit - Fiche d'identite</h1>
        <p class="font-mono text-base text-black/80 leading-relaxed" set:html={getFactCopy("copy-c83eb40cb993")} />
      </header>

      <div class="prose prose-lg max-w-none font-mono leading-relaxed">
        <h2 class="font-typewriter text-2xl">Informations essentielles</h2>
        <table>
          <tbody>
            <tr><th>Type</th><td set:html={getFactCopy("copy-9bbd593b579a")} /></tr>
            <tr><th>Ouverture</th><td set:html={getFactCopy("copy-a9e7236195af")} /></tr>
            <tr><th>Adresse</th><td set:html={getFactCopy("copy-e5f259857cfd")} /></tr>
            <tr><th>Situation</th><td set:html={getFactCopy("copy-d520e3481f00")} /></tr>
            <tr><th>Téléphone</th><td set:html={getFactCopy("copy-2e8843ff91f7")} /></tr>
            <tr><th>Email</th><td set:html={getFactCopy("copy-032812533778")} /></tr>
            <tr><th>Site web</th><td set:html={getFactCopy("copy-15b396413a5e")} /></tr>
            <tr><th>Horaires</th><td set:html={getFactCopy("copy-6b48038c7b97")} /></tr>
            <tr><th>Tarifs</th><td set:html={getFactCopy("copy-8123dde1f44f")} /></tr>
            <tr><th>Paiement</th><td set:html={getFactCopy("copy-c91f022253a2")} /></tr>
            <tr><th>Langues</th><td set:html={getFactCopy("copy-c7d77d5bc2ac")} /></tr>
          </tbody>
        </table>

        <h2 class="font-typewriter text-2xl">Équipement et fournisseurs</h2>
        <table>
          <tbody>
            <tr><th>Machine espresso</th><td set:html={getFactCopy("copy-da1886a7ac03")} /></tr>
            <tr><th>Moulin</th><td set:html={getFactCopy("copy-55f2a1217853")} /></tr>
            <tr><th>Eau</th><td set:html={getFactCopy("copy-53d1c7ae67e6")} /></tr>
            <tr><th>Café</th><td set:html={getFactCopy("copy-689311139935")} /></tr>
            <tr><th>Matcha</th><td set:html={getFactCopy("copy-3bb36b9e5e39")} /></tr>
            <tr><th>Boulangerie</th><td set:html={getFactCopy("copy-a55ca5f30bc8")} /></tr>
          </tbody>
        </table>

        <h2 class="font-typewriter text-2xl">Équipements et accessibilité</h2>
        <p set:html={getFactCopy("copy-dd9e7ad0faf5")} />

        <h2 class="font-typewriter text-2xl">Comment y aller</h2>
        <p set:html={getFactCopy("copy-afce2c5d133d")} />

        <p set:html={getFactCopy("copy-cf692b33cd80")} />
      </div>
    </div>
  </article>
</Layout>
