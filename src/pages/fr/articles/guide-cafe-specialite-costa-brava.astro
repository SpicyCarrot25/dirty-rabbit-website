const breadcrumbs = [
  { name: 'Accueil', url: 'https://dirtyrabbit.es/fr/' },
  { name: 'Articles', url: 'https://dirtyrabbit.es/fr/articles/' },
  { name: title, url: 'https://dirtyrabbit.es/fr/articles/guide-cafe-specialite-costa-brava' }
