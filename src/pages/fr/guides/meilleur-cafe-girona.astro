---
import { getFactCopy, getBusinessSchema, getBusinessField, serializeSchema } from '../../../lib/business-facts';
import Layout from '../../../layouts/Layout.astro';
import { getTranslations } from '../../../i18n';

const lang = 'fr';
// Editorial update (publication date unknown): dateModified: "2026-10-12"
const t = getTranslations(lang);

const locationName = "Girona";
const locationSlug = "girona";

const breadcrumbs = [
  { name: 'Accueil', url: 'https://dirtyrabbit.es/fr/' },
  { name: 'Guides', url: 'https://dirtyrabbit.es/fr/guides/' },
  { name: `Meilleur café à ${locationName}`, url: `https://dirtyrabbit.es/fr/guides/meilleur-cafe-${locationSlug}` }
];
---

<Layout 
  title={`Que voir et où prendre un café à ${locationName}`}
  description={`Découvrez ${locationName} et ses cafés. Puis, si vous souhaitez aller à S’Agaró, retrouvez Dirty Rabbit dans une autre localité.`}
  lang={lang}
  breadcrumbs={breadcrumbs}>

  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      
      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4">GUIDE LOCAL · CAFÉ DE SPÉCIALITÉ</p>
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">
          Que voir et où prendre un café à {locationName}
        </h1>
        <p class="font-mono text-lg text-black/70 leading-relaxed">
          Girona est la capitale provinciale et, grâce à sa communauté cycliste professionnelle, elle est devenue l'un des hauts lieux du café de spécialité en Espagne. Des anciens cyclistes pros aux baristas passionnés, la scène café ici est mature et diversifiée.
        </p>
      </header>

      <div class="prose prose-lg max-w-none">
        
        <section class="mb-16 p-8 bg-cream rounded-xl border-2 border-red">
          <h2 class="font-typewriter text-2xl md:text-3xl mb-4 flex items-center gap-3">
            <span class="text-3xl">🐇</span> Et sur la côte ? Dirty Rabbit à S'Agaró (35 min)
          </h2>
          <p class="font-mono text-sm text-red mb-4" set:html={getFactCopy("copy-13e83405928f")} />
          
          <p class="mb-4">
            Si vous descendez vers la Costa Brava depuis Girona, ne manquez pas Dirty Rabbit à S'Agaró.
          </p>
          
          <p class="mb-4">
            Nous servons <strong>La Cabra</strong> — le torréfacteur danois d'élite mondiale. Préparé sur <strong>La Marzocco KB90</strong>. C'est le meilleur café de la côte, et ça vaut le détour après avoir exploré la ville.
          </p>
          
          <p class="mb-4">
            Parfait pour combiner : café de spécialité à Girona le matin, route vers la côte, brunch chez nous, puis plage à Sant Pol.
          </p>
          
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block font-typewriter text-red hover:underline"
          >
            📍 Voir sur Google Maps →
          </a>
        </section>
<section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">La Fábrica</h2><p>Girona. <a href="https://www.lafabricagirona.com/" class="text-red underline">Site du café</a>. Sources consultées le 12/10/2026 ; vérifiez les horaires avant votre visite.</p></section>

        <section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">Espresso Mafia</h2><p>Girona. <a href="https://espressomafiagirona.com/policies/legal-notice" class="text-red underline">Site du café</a>. Sources consultées le 12/10/2026 ; vérifiez les horaires avant votre visite.</p></section>

        <section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">Oniria Café</h2><p>Ouverture actuelle non vérifiée ; contactez le café avant votre visite.</p></section>

        <section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">Autres options notables</h2><p>Ouverture actuelle non vérifiée ; contactez le café avant votre visite.</p></section>



        <h2 class="font-typewriter text-2xl md:text-3xl mb-6 mt-16">Le tour café parfait à Girona</h2>
        <ol class="space-y-2 mb-8">
          <li><strong>8h30</strong> — Espresso et croissant chez La Fábrica</li>
          <li><strong>9h30</strong> — Balade dans la vieille ville (cathédrale, quartier juif)</li>
          <li><strong>11h00</strong> — Vol de dégustation chez Espresso Mafia</li>
          <li><strong>12h00</strong> — Route vers S'Agaró (35 min)</li>
          <li><strong>12h45</strong> — Brunch chez Dirty Rabbit</li>
          <li><strong>14h30</strong> — Plage de Sant Pol et Camí de Ronda</li>
        </ol>

        <div class="mt-16 p-8 bg-black text-white rounded-xl text-center">
          <p class="font-typewriter text-2xl mb-4">De Girona à la mer</p>
          <p class="font-mono mb-6" set:html={getFactCopy("copy-8a3bcdd4f573")} />
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412"
            target="_blank"
            rel="noopener noreferrer" 
            class="inline-block font-typewriter px-8 py-3 bg-red text-cream rounded-lg hover:bg-red/90 transition-colors"
          >
            Comment venir
          </a>
        </div>

      </div>
    </div>

<p class="my-6"><a class="text-red underline" href="/en/guide/girona-to-costa-brava-day-trip-coffee-stop">Girona → Costa Brava: day trip &amp; coffee stop (English)</a></p></article>

</Layout>
