---
import { getFactCopy, getBusinessSchema, getBusinessField, serializeSchema } from '../../../lib/business-facts';
import Layout from '../../../layouts/Layout.astro';
import { getTranslations } from '../../../i18n';

const lang = 'fr';
// Editorial update (publication date unknown): dateModified: "2026-10-12"
const t = getTranslations(lang);

const locationName = "Sant Feliu de Guíxols";
const locationSlug = "sant-feliu-de-guixols";

const breadcrumbs = [
  { name: 'Accueil', url: 'https://dirtyrabbit.es/fr/' },
  { name: 'Guides', url: 'https://dirtyrabbit.es/fr/guides/' },
  { name: `Meilleur café à ${locationName}`, url: `https://dirtyrabbit.es/fr/guides/meilleur-cafe-${locationSlug}` }
];
---

<Layout 
  title={`Que voir et où prendre un café à ${locationName}`}
  description={`Découvrez ${locationName} et ses cafés. Puis, si vous souhaitez aller à S’Agaró, retrouvez Dirty Rabbit dans une autre localité.`}
  lang={lang}
  breadcrumbs={breadcrumbs}>

  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      
      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4">GUIDE LOCAL · CAFÉ DE SPÉCIALITÉ</p>
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">
          Que voir et où prendre un café à {locationName}
        </h1>
        <p class="font-mono text-lg text-black/70 leading-relaxed">
          Sant Feliu de Guíxols est une vraie ville de la Costa Brava — pas juste une station balnéaire. Port de pêche authentique, monastère bénédictin millénaire, tradition du liège... et depuis quelques années, une scène café de spécialité qui prend forme. Voici notre guide des meilleures adresses.
        </p>
      </header>

      <div class="prose prose-lg max-w-none">
        
        <section class="mb-16 p-8 bg-cream rounded-xl border-2 border-red">
          <h2 class="font-typewriter text-2xl md:text-3xl mb-4 flex items-center gap-3">
            <span class="text-3xl">🐇</span> Dirty Rabbit (notre café) — une autre étape à S’Agaró</h2>
          <p class="font-mono text-sm text-red mb-4" set:html={getFactCopy("copy-8ab5fb78343a")} />
          
          <p class="mb-4">
            Si vous voulez vraiment le meilleur café de spécialité de la région, faites les 7 minutes jusqu'à S'Agaró.
          </p>
          
          <p class="mb-4">
            Nous servons <strong>La Cabra</strong> — le torréfacteur danois qui figure dans le top mondial depuis des années. Café traçable jusqu'à la ferme, préparé sur <strong>La Marzocco KB90</strong> avec eau filtrée par osmose inverse. Ce n'est pas juste du bon café — c'est du café extraordinaire.
          </p>
          
          <p class="mb-4">
            En plus du café, nous proposons un vrai brunch : œufs bénédicte, bagels, bowls, toasts artisanaux. Le tout dans une ambiance décontractée qui mélange le meilleur de la Costa Brava avec une qualité internationale.
          </p>

          <h3 class="font-typewriter text-xl mt-8 mb-4">Comment venir depuis Sant Feliu</h3>
          <ul class="space-y-2 mb-6">
            <li><strong>7 minutes en voiture</strong> — Route directe, parking facile</li>
            <li><strong>30 minutes à pied</strong> — Par le magnifique Camí de Ronda</li>
            <li><strong>15 minutes à vélo</strong> — Route côtière agréable</li>
          </ul>
          
          <p class="mb-4">
            Nous parlons <strong>espagnol, catalan, anglais et polonais</strong>. Menus disponibles en français.
          </p>
          
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block font-typewriter text-red hover:underline"
          >
            📍 Voir sur Google Maps →
          </a>
        </section>
<section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">ANNNA</h2><p>Sant Feliu de Guíxols. <a href="https://www.annna.cc/" class="text-red underline">Site du café</a>. Sources consultées le 12/10/2026 ; vérifiez les horaires avant votre visite.</p></section>

        <section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">Maison Marcel</h2><p>Ouverture actuelle non vérifiée ; contactez le café avant votre visite.</p></section>



        <h2 class="font-typewriter text-2xl md:text-3xl mb-6 mt-16">Distances depuis Sant Feliu</h2>
        
        <div class="overflow-x-auto">
          <table class="w-full font-mono text-sm">
            <thead>
              <tr class="border-b-2 border-black">
                <th class="text-left py-3">Café</th>
                <th class="text-left py-3">Distance</th>
                <th class="text-left py-3">Temps</th>
                <th class="text-left py-3">Spécialité</th>
              </tr>
            </thead>
            <tbody><tr class="border-b border-black/20 bg-cream">
                <td class="py-3 font-bold">Dirty Rabbit (notre café)</td>
                <td class="py-3">5 km</td>
                <td class="py-3">7 min</td>
                <td class="py-3">La Cabra (Danemark)</td>
              </tr><tr class="border-b border-black/20">
                <td class="py-3">ANNNA</td>
                <td class="py-3">0 km</td>
                <td class="py-3">À Sant Feliu</td>
                <td class="py-3">Vérifiez la disponibilité auprès du café</td>
              </tr><tr class="border-b border-black/20">
                <td class="py-3">Maison Marcel</td>
                <td class="py-3">0 km</td>
                <td class="py-3">À Sant Feliu</td>
                <td class="py-3">Vérifiez la disponibilité auprès du café</td>
              </tr><tr class="border-b border-black/20">
                <td class="py-3">La Maglia</td>
                <td class="py-3">6 km</td>
                <td class="py-3">10 min</td>
                <td class="py-3">Vérifiez la disponibilité auprès du café</td>
              </tr></tbody>
          </table>
        </div>

        <h2 class="font-typewriter text-2xl md:text-3xl mb-6 mt-16">Le tour café parfait</h2>
        <p class="mb-4">Si vous avez une matinée complète :</p>
        <ol class="space-y-2 mb-8">
          <li><strong>9h00</strong> — Croissant chez Maison Marcel à Sant Feliu</li>
          <li><strong>10h00</strong> — Promenade sur le Camí de Ronda vers S'Agaró</li>
          <li><strong>11h00</strong> — Brunch et café La Cabra chez Dirty Rabbit</li>
          <li><strong>12h30</strong> — Baignade à la Platja de Sant Pol</li>
        </ol>

        <div class="mt-16 p-8 bg-black text-white rounded-xl text-center">
          <p class="font-typewriter text-2xl mb-4">On vous attend</p>
          <p class="font-mono mb-6" set:html={getFactCopy("copy-e5181cbbaf3b")} />
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412"
            target="_blank"
            rel="noopener noreferrer" 
            class="inline-block font-typewriter px-8 py-3 bg-red text-cream rounded-lg hover:bg-red/90 transition-colors"
          >
            Comment venir
          </a>
        </div>

      </div>
    </div>

</article>

</Layout>
