  <Fragment slot="head">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "CafeOrCoffeeShop"],
  "name": "Dirty Rabbit",
  "description": "Café de spécialité à S'Agaró, Costa Brava. Matcha cérémoniel de REQ Matcha, fondateur japonais. À 35 minutes de Gérone. Ouvert depuis novembre 2024.",
  "foundingDate": "2024-11-01",
