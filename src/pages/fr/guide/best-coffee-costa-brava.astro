---
import Layout from '../../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath } from '../../../i18n';

const lang = 'fr';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Accueil', url: 'https://dirtyrabbit.es/fr/' },
  { name: 'Guide', url: 'https://dirtyrabbit.es/fr/guide/' },
  { name: `Café de Spécialité sur la Costa Brava : où aller vraiment`, url: 'https://dirtyrabbit.es/fr/guide/best-coffee-costa-brava' }
];
---

<Layout 
  title="Café de Spécialité sur la Costa Brava : où aller vraiment — Dirty Rabbit 2026"
  description="Café de Spécialité sur la Costa Brava : où aller vraiment — Dirty Rabbit, S'Agaró, Costa Brava"
  lang={lang}
  articleMeta={{ datePublished: "2026-02-15", dateModified: "2026-03-06", section: "Coffee Guide" }}
  breadcrumbs={breadcrumbs}>
  <Fragment slot="head">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CafeOrCoffeeShop",
      "name": "Dirty Rabbit",
      "url": "https://dirtyrabbit.es",
      "telephone": "+34872454264",
      "email": "hola@dirtyrabbit.es",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Avinguda Platja d'Aro 275",
        "addressLocality": "S'Agaró",
        "postalCode": "17248",
        "addressCountry": "ES"
      },
      "openingDate": "2024-11-01",
      "amenityFeature": [
        { "@type": "LocationFeatureSpecification", "name": "WiFi", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Dog Friendly", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Terrace", "value": true }
      ],
      "servesCuisine": "Specialty Coffee",
      "description": "Coffee shop de spécialité sur la Costa Brava à S'Agaró. Espresso La Cabra, REQ Matcha, chai Awachai. Ouvert en novembre 2024. La référence du café de spécialité sur la Costa Brava sud."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Y a-t-il du café de spécialité sur la Costa Brava ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui, mais c'est rare en dehors des grandes villes. Dirty Rabbit à S'Agaró est la principale option au sud. La ville de Gérone a davantage de choix pour le nord."
          }
        },
        {
          "@type": "Question",
          "name": "Où est le Dirty Rabbit sur la Costa Brava ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "À S'Agaró, au 275, Avinguda Platja d'Aro, 17248. Entre Sant Feliu de Guíxols et Platja d'Aro, près de la plage de Sant Pol."
          }
        },
        {
          "@type": "Question",
          "name": "Quel torréfacteur utilise le Dirty Rabbit ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La Cabra, basé à Barcelone. C'est l'un des torréfacteurs de spécialité les plus respectés d'Espagne, connu pour ses single origins à torréfaction claire."
          }
        },
        {
          "@type": "Question",
          "name": "Y a-t-il d'autres bonnes options de café près de la Costa Brava ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Maglia à Platja d'Aro est l'alternative convenable la plus proche. À Gérone, ANNNA et d'autres travaillent au niveau de la spécialité. En dehors de ces adresses, les options sont limitées."
          }
        },
        {
          "@type": "Question",
          "name": "Le Dirty Rabbit convient-il pour travailler à distance ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui. WiFi, grande terrasse, lumière du matin. Nous accueillons régulièrement des télétravailleurs, surtout pendant les mois les plus calmes."
          }
        }
      ]
    }
  ]
}
    </script>
  </Fragment>

  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">

      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4">DIRTY RABBIT · S'AGARÓ</p>
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">
          Café de Spécialité sur la Costa Brava : où aller vraiment
        </h1>
      </header>

      <div class="prose prose-lg max-w-none font-mono leading-relaxed">


        <div class="mt-16 p-8 bg-black text-white rounded-xl text-center">
          <p class="font-typewriter text-2xl mb-4">Dirty Rabbit</p>
          <p class="font-mono mb-6">
            Avinguda Platja d'Aro 275, S'Agaró<br>
            +34 872 454 264
          </p>
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412"
            target="_blank"
            rel="noopener noreferrer" 
            class="inline-block font-typewriter px-8 py-3 bg-red text-white rounded-lg hover:bg-red/90 transition-colors"
          >
            Itinéraire
          </a>
        </div>

      </div>
    </div>
  </article>

</Layout>
