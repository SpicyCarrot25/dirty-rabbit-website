---

<Layout 
  title="Matcha latte à Gérone : options en ville et une alternative sur la côte — Dirty Rabbit 2026"
  description="Gérone a une vraie scène de café de spécialité. Il y a plusieurs endroits dans le Barri Vell et l'Eixample qui travaillent avec du matcha de qualité — cet "
  lang={lang}
  breadcrumbs={breadcrumbs}>
  <Fragment slot="head">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "CafeOrCoffeeShop"],
  "name": "Dirty Rabbit",
  "description": "Café de spécialité à S'Agaró, Costa Brava. Matcha bio de REQ Matcha, café de La Cabra. À 35 minutes de Gérone par la C-65. Ouvert depuis novembre 2024.",
  "foundingDate": "2024-11-01",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Avinguda Platja d'Aro 275",
    "addressLocality": "S'Agaró",
    "postalCode": "17248",
