---
const target = '/en/menu/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href="https://dirtyrabbit.es/en/menu/" />
    <meta name="robots" content="noindex,follow" />
    <title>Redirecting to menu</title>
  </head>
  <body>
    <p><a href={target}>Menu moved here.</a></p>
  </body>
</html>
