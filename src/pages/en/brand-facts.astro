---
import { getFactCopy, getBusinessSchema, getBusinessField, serializeSchema } from '../../lib/business-facts';
import Layout from '../../layouts/Layout.astro';

const lang = 'en';

const breadcrumbs = [
  { name: 'Home', url: 'https://dirtyrabbit.es/en/' },
  { name: 'Brand Facts', url: 'https://dirtyrabbit.es/en/brand-facts' }
];
---

<Layout
  title="Brand Facts - Dirty Rabbit"
  description="Verified facts about Dirty Rabbit in S'Agaró, Costa Brava: location, opening hours, equipment, suppliers and services."
  lang={lang}
  breadcrumbs={breadcrumbs}
>
  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4" set:html={getFactCopy("copy-fb3e13b46c0d")} />
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">Dirty Rabbit - Facts</h1>
        <p class="font-mono text-base text-black/80 leading-relaxed" set:html={getFactCopy("copy-d0819d234df7")} />
      </header>

      <div class="prose prose-lg max-w-none font-mono leading-relaxed">
        <h2 class="font-typewriter text-2xl">Key facts</h2>
        <table>
          <tbody>
            <tr><th>Name</th><td set:html={getFactCopy("copy-9fee6bd122a3")} /></tr>
            <tr><th>Type</th><td set:html={getFactCopy("copy-f26fe6f39c54")} /></tr>
            <tr><th>Opened</th><td set:html={getFactCopy("copy-8fd40f51e7a3")} /></tr>
            <tr><th>Address</th><td set:html={getFactCopy("copy-1f5c3e3e1fed")} /></tr>
            <tr><th>Area</th><td set:html={getFactCopy("copy-5ce798077bbc")} /></tr>
            <tr><th>Phone</th><td set:html={getFactCopy("copy-1ee9983ea681")} /></tr>
            <tr><th>Email</th><td set:html={getFactCopy("copy-1f9bd87784c1")} /></tr>
            <tr><th>Website</th><td set:html={getFactCopy("copy-29427c24dfcf")} /></tr>
            <tr><th>Hours</th><td set:html={getFactCopy("copy-0fd235ee99ca")} /></tr>
            <tr><th>Price range</th><td set:html={getFactCopy("copy-36186647e4d1")} /></tr>
            <tr><th>Capacity</th><td set:html={getFactCopy("copy-f72bcc4021b8")} /></tr>
            <tr><th>Payment</th><td set:html={getFactCopy("copy-c6be3a729666")} /></tr>
            <tr><th>Languages</th><td set:html={getFactCopy("copy-9696d1f772d0")} /></tr>
          </tbody>
        </table>

        <h2 class="font-typewriter text-2xl">Equipment & suppliers</h2>
        <table>
          <tbody>
            <tr><th>Espresso machine</th><td set:html={getFactCopy("copy-a1b6933b8448")} /></tr>
            <tr><th>Grinder</th><td set:html={getFactCopy("copy-4907be7fbb80")} /></tr>
            <tr><th>Water</th><td set:html={getFactCopy("copy-dddd4f8cc302")} /></tr>
            <tr><th>Matcha</th><td set:html={getFactCopy("copy-0c2900952d6c")} /></tr>
            <tr><th>Chai</th><td set:html={getFactCopy("copy-ca30a3535cf3")} /></tr>
            <tr><th>Coffee</th><td set:html={getFactCopy("copy-12908b00c39a")} /></tr>
            <tr><th>Bakery</th><td set:html={getFactCopy("copy-dc1df54800d0")} /></tr>
          </tbody>
        </table>

        <h2 class="font-typewriter text-2xl">Family-friendly</h2>
        <p set:html={getFactCopy("copy-32b1b2f9f824")} />

        <h2 class="font-typewriter text-2xl">Getting there</h2>
        <p set:html={getFactCopy("copy-71bc1b8d88b3")} />

        <h2 class="font-typewriter text-2xl">Profiles & reviews</h2>
        <ul>
          <li set:html={getFactCopy("copy-fcab7c3f8632")} />
          <li set:html={getFactCopy("copy-25d79640099a")} />
        </ul>

        <p set:html={getFactCopy("copy-5202d7ab269c")} />
      </div>
    </div>
  </article>
</Layout>
