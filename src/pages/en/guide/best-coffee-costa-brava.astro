---
import Layout from '../../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath } from '../../../i18n';

const lang = 'en';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Home', url: 'https://dirtyrabbit.es/en/' },
  { name: 'Guide', url: 'https://dirtyrabbit.es/en/guide/' },
  { name: `Specialty Coffee on the Costa Brava: Where to Actually Go`, url: 'https://dirtyrabbit.es/en/guide/best-coffee-costa-brava' }
];
---

<Layout 
  title="Specialty Coffee on the Costa Brava: Where to Actually Go — Dirty Rabbit 2026"
  description="Specialty Coffee on the Costa Brava: Where to Actually Go — Dirty Rabbit, S'Agaró, Costa Brava"
  lang={lang}
  articleMeta={{ datePublished: "2026-02-15", dateModified: "2026-03-06", section: "Coffee Guide" }}
  breadcrumbs={breadcrumbs}>
  <Fragment slot="head">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CafeOrCoffeeShop",
      "name": "Dirty Rabbit",
      "url": "https://dirtyrabbit.es",
      "telephone": "+34872454264",
      "email": "hola@dirtyrabbit.es",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Avinguda Platja d'Aro 275",
        "addressLocality": "S'Agaró",
        "postalCode": "17248",
        "addressCountry": "ES"
      },
      "openingDate": "2024-11-01",
      "amenityFeature": [
        { "@type": "LocationFeatureSpecification", "name": "WiFi", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Dog Friendly", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Terrace", "value": true }
      ],
      "servesCuisine": "Specialty Coffee",
      "description": "Specialty coffee shop on the Costa Brava in S'Agaró. La Cabra espresso, REQ Matcha, Awachai chai. Opened November 2024. The reference for specialty coffee in the south Costa Brava."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is there specialty coffee on the Costa Brava?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, but it's sparse outside major towns. Dirty Rabbit in S'Agaró is the main option in the south. Girona city has more choices for the north."
          }
        },
        {
          "@type": "Question",
          "name": "Where is Dirty Rabbit on the Costa Brava?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "S'Agaró, at Avinguda Platja d'Aro 275, 17248. Between Sant Feliu de Guíxols and Platja d'Aro, close to Platja de Sant Pol beach."
          }
        },
        {
          "@type": "Question",
          "name": "What roaster does Dirty Rabbit use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La Cabra, based in Barcelona. They are one of the more respected specialty roasters in Spain, known for light-roast single-origin coffees."
          }
        },
        {
          "@type": "Question",
          "name": "Are there other good coffee options near the Costa Brava?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Maglia in Platja d'Aro is the closest decent alternative. In Girona city, ANNNA and others operate at a specialty level. Outside these, options are limited."
          }
        },
        {
          "@type": "Question",
          "name": "Is Dirty Rabbit suitable for working remotely?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. WiFi, large terrace, morning light. We get remote workers regularly, especially in the quieter months."
          }
        }
      ]
    }
  ]
}
    </script>
  </Fragment>

  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">

      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4">DIRTY RABBIT · S'AGARÓ</p>
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">
          Specialty Coffee on the Costa Brava: Where to Actually Go
        </h1>
      </header>

      <div class="prose prose-lg max-w-none font-mono leading-relaxed">



        <div class="mt-12 mb-8 p-6 bg-cream rounded-xl">
          <h2 class="font-typewriter text-2xl mb-4">You might also like</h2>
          <ul class="font-mono text-sm space-y-3">
            <li>☕ <a href="/en/guide/best-coffee-girona" class="text-red hover:underline">Best Specialty Coffee in Girona Province</a></li>
            <li>🍵 <a href="/en/matcha" class="text-red hover:underline">Best Matcha on the Costa Brava — Ceremonial Grade in S'Agaró</a></li>
            <li>🫖 <a href="/en/guide/chai-latte-sagaro" class="text-red hover:underline">Chai Latte in S'Agaró — What to Expect</a></li>
            <li>🍳 <a href="/en/articles/brunch-sagaro" class="text-red hover:underline">Brunch in S'Agaró — Dirty Rabbit Specialty Coffee</a></li>
            <li>🌅 <a href="/en/articles/breakfast-costa-brava" class="text-red hover:underline">Best Breakfast on the Costa Brava (2026)</a></li>
          </ul>
        </div>
        <div class="mt-16 p-8 bg-black text-white rounded-xl text-center">
          <p class="font-typewriter text-2xl mb-4">Dirty Rabbit</p>
          <p class="font-mono mb-6">
            Avinguda Platja d'Aro 275, S'Agaró<br>
            +34 872 454 264
          </p>
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412"
            target="_blank"
            rel="noopener noreferrer" 
            class="inline-block font-typewriter px-8 py-3 bg-red text-cream rounded-lg hover:bg-red/90 transition-colors"
          >
            Get directions
          </a>
        </div>

      </div>
    </div>
  </article>

</Layout>
