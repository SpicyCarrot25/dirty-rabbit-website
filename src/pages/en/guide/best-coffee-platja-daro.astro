---
import { getFactCopy, getBusinessSchema, getBusinessField, serializeSchema } from '../../../lib/business-facts';
import Layout from '../../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath } from '../../../i18n';

const lang = 'en';
const t = getTranslations(lang);

const locationName = "Platja d'Aro";
const locationSlug = "platja-daro";

const breadcrumbs = [
  { name: 'Home', url: 'https://dirtyrabbit.es/en/' },
  { name: 'Guide', url: 'https://dirtyrabbit.es/en/guide/' },
  { name: `Best coffee near ${locationName}`, url: `https://dirtyrabbit.es/en/guide/best-coffee-${locationSlug}` }
];
---

<Layout 
  title={`Things to do and coffee in ${locationName}`}
  description={`Explore ${locationName} and its cafés. Then, if you fancy a trip to S’Agaró, visit Dirty Rabbit in a separate town.`}
  lang={lang}
  articleMeta={{ datePublished: "2026-02-15", dateModified: "2026-10-12", section: "Coffee Guide" }}
  breadcrumbs={breadcrumbs}>

  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      
      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4">LOCAL GUIDE · SPECIALTY COFFEE</p>
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">
          Things to do and coffee in {locationName}
        </h1>
        <p class="font-mono text-lg text-black/70 leading-relaxed">
          {locationName} is synonymous with Costa Brava summer: kilometres of beach, a lively seafront promenade, and nightlife that never stops. But if you're after proper coffee — fresh roast aromas, well-textured milk, a barista who knows their craft — the game changes. Here's our honest guide.
        </p>
      </header>


      <div class="prose prose-lg max-w-none">
        
        <section class="mb-16 p-8 bg-cream rounded-xl border-2 border-red">
          <h2 class="font-typewriter text-2xl md:text-3xl mb-4 flex items-center gap-3">
            <span class="text-3xl">🐇</span> Dirty Rabbit (our café) — a separate stop in S’Agaró</h2>
          <p class="font-mono text-sm text-red mb-4" set:html={getFactCopy("copy-4a1373152af8")} />
          
          <p class="mb-4">
            If you want the best specialty coffee on the Costa Brava, it's worth the 5 minutes to S'Agaró.
          </p>
          
          <p class="mb-4">
            We serve <strong>La Cabra</strong> — the Danish roaster that's been in the global specialty elite for years. This isn't "good" coffee — it's extraordinary: traceable to the farm, precision-processed, roasted in Copenhagen by one of the world's best teams. We prepare it on our <strong>La Marzocco KB90</strong> with <strong>RO-filtered water</strong> — every variable controlled to bring out the best of the bean.
          </p>
          
          <p class="mb-4">
            But Dirty Rabbit isn't just coffee. It's a place to sit with your book, have eggs benedict after a swim at Sant Pol, or end up chatting with the table next to you. We call it "home away from home" because that's exactly what we want it to be.
          </p>

          <h3 class="font-typewriter text-xl mt-8 mb-4">Why come from {locationName}?</h3>
          <ul class="space-y-2 mb-6">
            <li><strong>5 minutes by car</strong> via the S'Agaró road (GI-682). Easy parking outside peak season.</li>
            <li><strong>15 minutes by bike</strong> along the coast — perfect combined with a stop at Sant Pol Beach.</li>
            <li><strong>25 minutes walking</strong> via the Camí de Ronda if you fancy a spectacular route.</li>
          </ul>

          <p><a href="/en/brand-facts" class="text-red underline">Our café facts</a></p>
          
          <p class="mb-4">
            We speak <strong>Spanish, Catalan, English, and Polish</strong> — menus also in Russian, French, and Ukrainian.
          </p>
          
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block font-typewriter text-red hover:underline"
          >
            📍 View on Google Maps →
          </a>
        </section><aside class="mb-8 p-4 bg-cream border-l-4 border-red" data-seasonal-status="fitzroy"><p>Fitzroy is closed for the season; the reopening date is unconfirmed. This is not a permanent closure. Check its website before planning a visit. <a href="https://fitzroycafe.com/" class="text-red underline">Fitzroy</a> · 12/10/2026</p></aside>
<section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">La Maglia</h2><p>Platja d’Aro. <a href="https://www.lamaglia.cafe/" class="text-red underline">Venue website</a>. Sources checked on 12 October 2026; check opening hours before visiting.</p></section>

        <section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">ANNNA</h2><p>Sant Feliu de Guíxols. <a href="https://www.annna.cc/" class="text-red underline">Venue website</a>. Sources checked on 12 October 2026; check opening hours before visiting.</p></section>



        <h2 class="font-typewriter text-2xl md:text-3xl mb-6 mt-16">Map and distances from {locationName}</h2>
        
        <div class="overflow-x-auto">
          <table class="w-full font-mono text-sm">
            <thead>
              <tr class="border-b-2 border-black">
                <th class="text-left py-3">Café</th>
                <th class="text-left py-3">Distance</th>
                <th class="text-left py-3">Drive time</th>
                <th class="text-left py-3">Type</th>
              </tr>
            </thead>
            <tbody><tr class="border-b border-black/20">
                <td class="py-3 font-bold">Dirty Rabbit (our café)</td>
                <td class="py-3">3.5 km</td>
                <td class="py-3">5 min</td>
                <td class="py-3">La Cabra (Denmark)</td>
              </tr><tr class="border-b border-black/20">
                <td class="py-3">La Maglia</td>
                <td class="py-3">0 km</td>
                <td class="py-3">In Platja d'Aro</td>
                <td class="py-3">Check availability with the venue</td>
              </tr><tr class="border-b border-black/20">
                <td class="py-3">ANNNA</td>
                <td class="py-3">5 km</td>
                <td class="py-3">7 min</td>
                <td class="py-3">Check availability with the venue</td>
              </tr></tbody>
          </table>
        </div>

        <h2 class="font-typewriter text-2xl md:text-3xl mb-6 mt-16">More specialty options on Costa Brava?</h2>
        <ul class="space-y-2 mb-8">
          <li><strong>Fitzroy Café (closed for the season)</strong> — Check availability with the venue.</li>
          <li><strong>Grava</strong> — Check availability with the venue.</li>
        </ul>
        <p>Costa Brava is getting more and more options for specialty coffee lovers. We love that.</p>


        <div class="mt-12 mb-8 p-6 bg-cream rounded-xl">
          <h2 class="font-typewriter text-2xl mb-4">You might also like</h2>
          <ul class="font-mono text-sm space-y-3">
            <li>☕ <a href="/en/guide/best-coffee-girona" class="text-red hover:underline">Best Specialty Coffee in Girona Province</a></li>
            <li>🍵 <a href="/en/matcha" class="text-red hover:underline">Best Matcha on the Costa Brava — Ceremonial Grade in S'Agaró</a></li>
            <li>🫖 <a href="/en/guide/chai-latte-sagaro" class="text-red hover:underline">Chai Latte in S'Agaró — What to Expect</a></li>
            <li>🍳 <a href="/en/articles/brunch-sagaro" class="text-red hover:underline">Brunch in S'Agaró — Dirty Rabbit Specialty Coffee</a></li>
            <li>🌅 <a href="/en/articles/breakfast-costa-brava" class="text-red hover:underline">Best Breakfast on the Costa Brava (2026)</a></li>
          </ul>
        </div>
        <div class="mt-16 p-8 bg-black text-white rounded-xl text-center">
          <p class="font-typewriter text-2xl mb-4">Coming to see us?</p>
          <p class="font-mono mb-6" set:html={getFactCopy("copy-336595948887")} />
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412"
            target="_blank"
            rel="noopener noreferrer" 
            class="inline-block font-typewriter px-8 py-3 bg-red text-cream rounded-lg hover:bg-red/90 transition-colors"
          >
            Get directions
          </a>
        </div>

      </div>
    </div>

</article>

</Layout>
