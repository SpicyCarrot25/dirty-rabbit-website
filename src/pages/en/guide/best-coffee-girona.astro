---
import { getFactCopy, getBusinessSchema, getBusinessField, serializeSchema } from '../../../lib/business-facts';
import Layout from '../../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath } from '../../../i18n';

const lang = 'en';
const t = getTranslations(lang);

const locationName = "Girona";
const locationSlug = "girona";

const breadcrumbs = [
  { name: 'Home', url: 'https://dirtyrabbit.es/en/' },
  { name: 'Guide', url: 'https://dirtyrabbit.es/en/guide/' },
  { name: `Best coffee in ${locationName}`, url: `https://dirtyrabbit.es/en/guide/best-coffee-${locationSlug}` }
];
---

<Layout 
  title={`Things to do and coffee in ${locationName}`}
  description={`Explore ${locationName} and its cafés. Then, if you fancy a trip to S’Agaró, visit Dirty Rabbit in a separate town.`}
  lang={lang}
  articleMeta={{ datePublished: "2026-02-15", dateModified: "2026-10-12", section: "Coffee Guide" }}
  breadcrumbs={breadcrumbs}>

  <article class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      
      <header class="mb-12">
        <p class="font-mono text-sm text-red tracking-wider mb-4">LOCAL GUIDE · SPECIALTY COFFEE</p>
        <h1 class="font-typewriter text-4xl md:text-5xl lg:text-6xl mb-6">
          Things to do and coffee in {locationName}
        </h1>
        <p class="font-mono text-lg text-black/70 leading-relaxed">
          Girona is the specialty coffee capital of Catalonia outside Barcelona. Small city, beautiful old town, and an international cycling community that has transformed the coffee scene. Here are the best options — and a reason to head to the coast afterwards.
        </p>
      </header>

      <div class="prose prose-lg max-w-none">
        
        <section class="mb-16 p-8 bg-cream rounded-xl border-2 border-red">
          <h2 class="font-typewriter text-2xl md:text-3xl mb-4 flex items-center gap-3">
            <span class="text-3xl">🐇</span> Dirty Rabbit (our café) — a separate stop in S’Agaró</h2>
          <p class="font-mono text-sm text-red mb-4" set:html={getFactCopy("copy-8d95e7d453bf")} />
          
          <p class="mb-4">
            If after Girona you fancy beach and the best coffee on Costa Brava, Dirty Rabbit is 35 minutes away in S'Agaró.
          </p>
          
          <p class="mb-4">
            We serve <strong>La Cabra</strong> — the Danish roaster competing at the same level as Approachable. Full traceability, precision roasting, prepared on our <strong>La Marzocco KB90</strong> with <strong>RO-filtered water</strong>.
          </p>
          
          <p class="mb-4">
            Combine a day in Girona with an S'Agaró sunset: coffee, swim at Sant Pol, Camí de Ronda. Perfect plan.
          </p>

          <p><a href="/en/brand-facts" class="text-red underline">Our café facts</a></p>
          
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block font-typewriter text-red hover:underline"
          >
            📍 View on Google Maps →
          </a>
        </section>
<section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">La Fábrica</h2><p>Girona. <a href="https://www.lafabricagirona.com/" class="text-red underline">Venue website</a>. Sources checked on 12 October 2026; check opening hours before visiting.</p></section>

        <section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">Espresso Mafia</h2><p>Girona. <a href="https://espressomafiagirona.com/policies/legal-notice" class="text-red underline">Venue website</a>. Sources checked on 12 October 2026; check opening hours before visiting.</p></section>

        <section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">Oniria Café</h2><p>Current opening status unverified; contact the venue before visiting.</p></section>

        <section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">Originem</h2><p>Current opening status unverified; contact the venue before visiting.</p></section>

        <section class="mb-8"><h2 class="font-typewriter text-2xl mb-3">Hors Catégorie</h2><p>Current opening status unverified; contact the venue before visiting.</p></section>



        <h2 class="font-typewriter text-2xl md:text-3xl mb-6 mt-16">Specialty cafés in {locationName}</h2>
        
        <div class="overflow-x-auto">
          <table class="w-full font-mono text-sm">
            <thead>
              <tr class="border-b-2 border-black">
                <th class="text-left py-3">Café</th>
                <th class="text-left py-3">Location</th>
                <th class="text-left py-3">Coffee</th>
              </tr>
            </thead>
            <tbody><tr class="border-b border-black/20">
                <td class="py-3 font-bold">Dirty Rabbit (our café)</td>
                <td class="py-3">S'Agaró (35 min)</td>
                <td class="py-3">La Cabra (Denmark)</td>
              </tr><tr class="border-b border-black/20">
                <td class="py-3">La Fábrica</td>
                <td class="py-3">Old town</td>
                <td class="py-3">Check availability with the venue</td>
              </tr><tr class="border-b border-black/20">
                <td class="py-3">Espresso Mafia</td>
                <td class="py-3">Old town</td>
                <td class="py-3">Check availability with the venue</td>
              </tr><tr class="border-b border-black/20">
                <td class="py-3">Oniria Café</td>
                <td class="py-3">Old town</td>
                <td class="py-3">Check availability with the venue</td>
              </tr><tr class="border-b border-black/20">
                <td class="py-3">Originem</td>
                <td class="py-3">Old town</td>
                <td class="py-3">Check availability with the venue</td>
              </tr><tr class="border-b border-black/20">
                <td class="py-3">Hors Catégorie</td>
                <td class="py-3">Old town</td>
                <td class="py-3">Check availability with the venue</td>
              </tr><tr class="border-b border-black/20">
                <td class="py-3">Federal Café</td>
                <td class="py-3">Old town</td>
                <td class="py-3">Check availability with the venue</td>
              </tr></tbody>
          </table>
        </div>


        <div class="mt-12 mb-8 p-6 bg-cream rounded-xl">
          <h2 class="font-typewriter text-2xl mb-4">You might also like</h2>
          <ul class="font-mono text-sm space-y-3">
            <li>☕ <a href="/en/guide/best-coffee-girona" class="text-red hover:underline">Best Specialty Coffee in Girona Province</a></li>
            <li>🍵 <a href="/en/matcha" class="text-red hover:underline">Best Matcha on the Costa Brava — Ceremonial Grade in S'Agaró</a></li>
            <li>🫖 <a href="/en/guide/chai-latte-sagaro" class="text-red hover:underline">Chai Latte in S'Agaró — What to Expect</a></li>
            <li>🍳 <a href="/en/articles/brunch-sagaro" class="text-red hover:underline">Brunch in S'Agaró — Dirty Rabbit Specialty Coffee</a></li>
            <li>🌅 <a href="/en/articles/breakfast-costa-brava" class="text-red hover:underline">Best Breakfast on the Costa Brava (2026)</a></li>
          </ul>
        </div>
        <div class="mt-16 p-8 bg-black text-white rounded-xl text-center">
          <p class="font-typewriter text-2xl mb-4">Heading to the coast?</p>
          <p class="font-mono mb-6" set:html={getFactCopy("copy-2f4d66559077")} />
          <a 
            href="https://www.google.com/maps?cid=13237319999262880412"
            target="_blank"
            rel="noopener noreferrer" 
            class="inline-block font-typewriter px-8 py-3 bg-red text-cream rounded-lg hover:bg-red/90 transition-colors"
          >
            Get directions
          </a>
        </div>

      </div>
    </div>

<p class="my-6"><a class="text-red underline" href="/en/guide/girona-to-costa-brava-day-trip-coffee-stop">Girona → Costa Brava: day trip &amp; coffee stop (English)</a></p></article>

</Layout>
